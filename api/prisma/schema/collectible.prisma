// use prisma-next

// 「短句」每日藏品域：AI 每日生成一张精美闪卡（藏品），用户完成每日目标后获得。
// 公共约定（snake_case 映射 / 哨兵值 / 注释落库）见 base.prisma。

/// 每日藏品（一天一张，由定时任务 AI 生成；bizDate 唯一即幂等保证）
model DailyCollectible {
  /// 主键
  id BigInt @id @default(autoincrement()) @db.BigInt
  /// 业务日期（YYYY-MM-DD，唯一：一天一张，重复触发幂等跳过）
  bizDate String @unique @map("biz_date") @db.VarChar(10)
  /// 主题标题（英文，如 Morning Ritual）
  title String @db.VarChar(80)
  /// 主题标题（中文）
  titleZh String @map("title_zh") @db.VarChar(80)
  /// 卡面短句（英文）
  sentenceEn String @map("sentence_en") @db.VarChar(200)
  /// 短句中文释义
  translationZh String @map("translation_zh") @db.VarChar(200)
  /// 生图提示词（运营审核）
  scenePrompt String @map("scene_prompt") @db.VarChar(500)
  /// 配图文件 id（0 = 未生成，指向 sys_file；故不建外键）
  imageFileId BigInt @default(0) @map("image_file_id") @db.BigInt
  /// 状态：pending 待生成 / ready 就绪 / failed 失败
  status String @default("pending") @db.VarChar(20)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  grants UserCollectible[]

  @@index([status, bizDate])
  @@map("daily_collectible")
}

/// 用户藏品（userId + collectibleId 唯一，重复领取被唯一键拦截）
model UserCollectible {
  /// 主键
  id BigInt @id @default(autoincrement()) @db.BigInt
  /// 用户 id
  userId BigInt @map("user_id") @db.BigInt
  /// 藏品 id
  collectibleId BigInt @map("collectible_id") @db.BigInt
  /// 获得时间
  obtainedAt DateTime @default(now()) @map("obtained_at")

  collectible DailyCollectible @relation(fields: [collectibleId], references: [id])

  /// 同一用户同一藏品只能获得一次
  @@unique([userId, collectibleId])
  @@index([userId, obtainedAt])
  @@map("user_collectible")
}
