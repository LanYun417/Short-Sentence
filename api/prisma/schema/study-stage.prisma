// use prisma-next

/// 情景闯关进度（一行 = 用户在某关卡的对话进度；storyId 为空的行为旧版答题统计）。
///
/// **为什么不从 sentence_record 派生**：答题记录默认只保留 30 天
/// （每日 00:20 清理 `< now-30d`），派生口径会让用户一个月后「通关进度倒退」，
/// 关卡也会重新上锁。本表只增不减，是解锁与通关奖励的权威依据。
///
/// 2026-11-10 重构：玩法主键从 categoryId 改为 storyId（一个分类下可以有多个剧本/关卡），
/// 旧版答题统计（correctCount/answerCount）仍按分类记一行（storyId=null）。
model StudyStageProgress {
  /// 主键
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  /// 用户 id（client_user）
  userId       BigInt    @map("user_id") @db.BigInt
  /// 场景分类 id（sentence_category）：统计维度，保留
  categoryId   BigInt    @map("category_id") @db.BigInt
  /// 关卡 id（stage_story）：对话进度按关卡记；null = 旧版答题统计行
  storyId      BigInt?   @map("story_id") @db.BigInt
  /// 累计答对数（只增不减，用于旧版进度展示）
  correctCount Int       @default(0) @map("correct_count") @db.Int
  /// 累计作答数（含答错）
  answerCount  Int       @default(0) @map("answer_count") @db.Int
  /// 首次通关时间（旧版「答对 N 句」口径；仅作历史展示，不再决定解锁）
  clearedAt    DateTime? @map("cleared_at")
  /// 对话模式通关时间（null = 未通关；解锁与奖励以它为准）
  dialogueClearedAt DateTime? @map("dialogue_cleared_at")
  /// 最近一次通关对话的用户轮数（展示用）
  dialogueTurns     Int       @default(0) @map("dialogue_turns") @db.Int
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// 一个用户在一个关卡只有一行（storyId 为 null 的旧行不受此约束，MySQL 唯一索引允许多个 NULL）
  @@unique([userId, storyId])
  @@index([userId, categoryId])
  @@map("study_stage_progress")
}

/// 情景对话会话（一次「场景长对话」= 一行）。
///
/// 玩法：用户扮演场景角色，与 1~3 个 AI 角色围绕 goal 对话；
/// 聊够 minTurns 轮且 AI 判定目标达成才算通关（cleared=true）。
/// 对话内容与进度分表：消息量大，且历史会话需要完整保留供复盘。
model StageDialogueSession {
  /// 主键
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  /// 用户 id（client_user）
  userId       BigInt    @map("user_id") @db.BigInt
  /// 关卡 id（stage_story）：一关一局，进度与解锁按它记
  storyId      BigInt    @map("story_id") @db.BigInt
  /// 场景分类 id（sentence_category）：统计维度（按场景汇总会话数）
  categoryId   BigInt    @map("category_id") @db.BigInt
  /// active 进行中 / completed 已通关 / ended 未达成结束 / abandoned 重新开始
  status       String    @default("active") @db.VarChar(20)
  /// 用户已发言轮数（NPC 开场白不计）
  turnCount    Int       @default(0) @map("turn_count") @db.Int
  /// AI 是否判定目标达成
  goalReached  Boolean   @default(false) @map("goal_reached")
  /// 是否通关（goalReached && turnCount >= minTurns）
  cleared      Boolean   @default(false)
  /// 用户当前是否显示中文翻译（默认 true；关闭后不显示 NPC 台词翻译，通关经验更高）
  showTranslation Boolean @default(true) @map("show_translation")
  /// 本局是否曾借助翻译（任一句话发送时翻译处于开启即记为 true，**不可逆**；反作弊：用于无翻译通关加成）
  translationUsed  Boolean @default(false) @map("translation_used")
  /// 最近一轮模型给出的候选英文短句（JSON 数组；续聊/刷新时回显，避免丢失；null = 用剧情 starterHints）
  lastHints   String?   @map("last_hints") @db.Text
  /// 中文总结（结束时生成，2~3 句）
  summary      String?   @db.Text
  /// 复盘 JSON：{"highlights":["..."],"improvements":["..."]}
  feedback     String?   @db.Text
  /// 开始时间
  startedAt    DateTime  @default(now()) @map("started_at")
  /// 结束时间（null = 进行中）
  endedAt      DateTime? @map("ended_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages StageDialogueMessage[]

  /// 按「用户 + 关卡 + 状态」找进行中的会话
  @@index([userId, storyId, status])
  @@index([categoryId])
  @@map("stage_dialogue_session")
}

/// 情景对话消息（一行 = 一句台词）。
model StageDialogueMessage {
  /// 主键
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  /// 所属会话
  sessionId BigInt   @map("session_id") @db.BigInt
  /// npc / user
  role      String   @db.VarChar(10)
  /// 说话角色 nameEn（user 消息为 null）
  speaker   String?  @db.VarChar(40)
  /// 英文内容
  contentEn String   @map("content_en") @db.VarChar(500)
  /// 中文翻译（NPC 台词必填，user 消息可空）
  contentZh String?  @map("content_zh") @db.VarChar(300)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  session StageDialogueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
  @@map("stage_dialogue_message")
}

/// 情景闯关「章节封面」：一章一张 AI 生成图，存 file 表，这里只留 chapter_key → file_id 映射。
/// 情景闯关「剧本」：挂在场景（sentence_category）下的一条身份/故事线。
///
/// 层级：场景（分类）→ 剧本（本表）→ 关卡（stage_story）。
/// 一个场景可以有多个剧本（如「职场办公」下：程序员的一天 / 便利店店员 / 销售拜访），
/// 一个剧本下可以有多关；关卡主键是自身 id，进度/会话都按 storyId 记，与分类解耦。
model StageScript {
  /// 主键
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  /// 所属场景分类 id（sentence_category）
  categoryId  BigInt   @map("category_id") @db.BigInt
  /// 剧本名（如「程序员的一天」）
  name        String   @db.VarChar(100)
  /// 简介（一句话，展示在剧本卡上）
  blurb       String   @default("") @db.VarChar(500)
  /// 封面图文件 id（file 表；0 = 未生成，客户端回落渐变+图标）
  coverFileId BigInt   @default(0) @map("cover_file_id") @db.BigInt
  /// 场景内排序（越小越靠前）
  sort        Int      @default(0) @db.Int
  /// 1 启用 / 0 停用（停用后客户端不可见，历史进度保留）
  status      Int      @default(1) @db.TinyInt
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([categoryId, sort])
  @@map("stage_script")
}

/// 情景闯关「关卡」：一个剧本下的一关（一段可对话的剧情）。
///
/// 2026-11-10 重构：从「一分类一关卡」改为「剧本下多关卡」，主键是自身 id，
/// 进度/会话按 storyId 记录，删改关卡不会伤历史数据。
/// 服务启动时用代码种子 STAGE_STORIES **幂等回填**（同剧本下同名标题跳过，不覆盖运营改动）。
model StageStory {
  /// 主键
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  /// 所属剧本 id（stage_script）
  scriptId    BigInt   @map("script_id") @db.BigInt
  /// 关卡标题（剧情化场景名）
  title       String   @db.VarChar(100)
  /// 进入关卡的剧情引入
  intro       String   @db.Text
  /// 通关后的剧情收束
  outro       String   @db.Text
  /// 用户扮演的角色（喂给模型）
  userRole    String   @map("user_role") @db.VarChar(200)
  /// 场景设定（喂给模型）
  setting     String   @db.Text
  /// 对话目标（展示 + AI 通关判定）
  goal        String   @db.Text
  /// 通关所需最少用户轮数
  minTurns    Int      @map("min_turns") @db.Int
  /// 硬上限轮数
  maxTurns    Int      @map("max_turns") @db.Int
  /// 旧版「答对 N 句」通关线（仅历史统计）
  target      Int      @default(5) @db.Int
  /// 通关奖励经验
  rewardXp    Int      @map("reward_xp") @db.Int
  /// 出场角色 JSON：[{nameEn,name,persona,emoji}]（1~3 人）
  roles       Json
  /// 开场白 JSON：[{speaker,contentEn,contentZh}]
  opening     Json
  /// 候选英文短句 JSON：[{en,zh}]
  starterHints Json     @map("starter_hints")
  /// 剧本内排序（越小越靠前）
  sort        Int      @default(0) @db.Int
  /// 1 启用 / 0 停用（停用后客户端地图与详情都不可见，历史进度保留）
  status      Int      @default(1) @db.TinyInt
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([scriptId, sort])
  @@map("stage_story")
}
