// use prisma-next

/// 情景闯关进度（一行 = 用户在某场景关卡上的累计进度）。
///
/// **为什么不从 sentence_record 派生**：答题记录默认只保留 30 天
/// （每日 00:20 清理 `< now-30d`），派生口径会让用户一个月后「通关进度倒退」，
/// 关卡也会重新上锁。本表只增不减，是解锁与通关奖励的权威依据。
///
/// 与答题/打卡/句签同口径，刻意不与 client_user 建 Prisma 关系，按 userId 显式查询。
model StudyStageProgress {
  /// 主键
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  /// 用户 id（client_user）
  userId       BigInt    @map("user_id") @db.BigInt
  /// 场景分类 id（sentence_category）：关卡 = 场景
  categoryId   BigInt    @map("category_id") @db.BigInt
  /// 累计答对数（只增不减，用于通关判定与进度展示）
  correctCount Int       @default(0) @map("correct_count") @db.Int
  /// 累计作答数（含答错）
  answerCount  Int       @default(0) @map("answer_count") @db.Int
  /// 首次通关时间（旧版「答对 N 句」口径；仅作历史展示，不再决定解锁）
  clearedAt    DateTime? @map("cleared_at")
  /// 对话模式通关时间（null = 未通关；解锁与奖励以它为准）
  dialogueClearedAt DateTime? @map("dialogue_cleared_at")
  /// 最近一次通关对话的用户轮数（展示用）
  dialogueTurns     Int       @default(0) @map("dialogue_turns") @db.Int
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// 一个用户在一个场景只有一行
  @@unique([userId, categoryId])
  @@index([userId])
  @@map("study_stage_progress")
}

/// 情景对话会话（一次「场景长对话」= 一行）。
///
/// 玩法：用户扮演场景角色，与 1~3 个 AI 角色围绕 goal 对话；
/// 聊够 minTurns 轮且 AI 判定目标达成才算通关（cleared=true）。
/// 对话内容与进度分表：消息量大，且历史会话需要完整保留供复盘。
model StageDialogueSession {
  /// 主键
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  /// 用户 id（client_user）
  userId       BigInt    @map("user_id") @db.BigInt
  /// 场景分类 id（sentence_category）：关卡 = 场景
  categoryId   BigInt    @map("category_id") @db.BigInt
  /// active 进行中 / completed 已通关 / ended 未达成结束 / abandoned 重新开始
  status       String    @default("active") @db.VarChar(20)
  /// 用户已发言轮数（NPC 开场白不计）
  turnCount    Int       @default(0) @map("turn_count") @db.Int
  /// AI 是否判定目标达成
  goalReached  Boolean   @default(false) @map("goal_reached")
  /// 是否通关（goalReached && turnCount >= minTurns）
  cleared      Boolean   @default(false)
  /// 用户当前是否显示中文翻译（默认 true；关闭后不显示 NPC 台词翻译，通关经验更高）
  showTranslation Boolean @default(true) @map("show_translation")
  /// 本局是否曾借助翻译（任一句话发送时翻译处于开启即记为 true，**不可逆**；反作弊：用于无翻译通关加成）
  translationUsed  Boolean @default(false) @map("translation_used")
  /// 最近一轮模型给出的候选英文短句（JSON 数组；续聊/刷新时回显，避免丢失；null = 用剧情 starterHints）
  lastHints   String?   @map("last_hints") @db.Text
  /// 中文总结（结束时生成，2~3 句）
  summary      String?   @db.Text
  /// 复盘 JSON：{"highlights":["..."],"improvements":["..."]}
  feedback     String?   @db.Text
  /// 开始时间
  startedAt    DateTime  @default(now()) @map("started_at")
  /// 结束时间（null = 进行中）
  endedAt      DateTime? @map("ended_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages StageDialogueMessage[]

  /// 按「用户 + 场景 + 状态」找进行中的会话
  @@index([userId, categoryId, status])
  @@map("stage_dialogue_session")
}

/// 情景对话消息（一行 = 一句台词）。
model StageDialogueMessage {
  /// 主键
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  /// 所属会话
  sessionId BigInt   @map("session_id") @db.BigInt
  /// npc / user
  role      String   @db.VarChar(10)
  /// 说话角色 nameEn（user 消息为 null）
  speaker   String?  @db.VarChar(40)
  /// 英文内容
  contentEn String   @map("content_en") @db.VarChar(500)
  /// 中文翻译（NPC 台词必填，user 消息可空）
  contentZh String?  @map("content_zh") @db.VarChar(300)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  session StageDialogueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
  @@map("stage_dialogue_message")
}
