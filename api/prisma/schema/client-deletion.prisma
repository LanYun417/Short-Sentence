// use prisma-next

// 「短句」账号注销域：记录「为什么走」，**不记录是谁**。
//
// 为什么单独一张表而不是塞进 client_feedback：
// - 反馈是「还留着的用户」说的话，带 userId、能被回复；注销记录必须与身份脱钩，
//   否则「删号了还留着你 id」就是隐私政策里说不通的事。
// - 因此这里刻意没有 userId / email / nickname，只留匿名原因与注销时的状态快照，
//   用途是产品分析（用户在哪个阶段、因为什么流失）与合规审计（确有注销行为发生）。

/// 账号注销记录（匿名，不含任何用户标识）
model ClientAccountDeletion {
  /// 主键
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  /// 注销原因类型：no_time 没时间 / too_hard 太难 / content 内容不满意 / bugs 使用有问题 / privacy 隐私顾虑 / other 其他；用户未选择时为 unspecified
  reasonType   String   @default("unspecified") @map("reason_type") @db.VarChar(20)
  /// 补充说明（用户自填，可选）
  reasonDetail String?  @map("reason_detail") @db.VarChar(200)
  /// 注销时的经验值快照（用来看「练到多深才走」）
  xp           Int      @default(0) @db.Int
  /// 注销时的累计打卡天数快照
  checkinDays  Int      @default(0) @map("checkin_days") @db.Int
  /// 注销时的答题数快照（答题记录只保留 30 天，故为近 30 天）
  answerCount  Int      @default(0) @map("answer_count") @db.Int
  /// 账号注册时间（与 createdAt 相减即「用了多久才走」）
  registeredAt DateTime @map("registered_at")
  /// 注销时间
  createdAt    DateTime @default(now()) @map("created_at")

  /// 后台按时间倒序翻页 + 按原因统计分布
  @@index([createdAt])
  @@index([reasonType])
  @@map("client_account_deletion")
}
