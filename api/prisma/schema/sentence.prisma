// use prisma-next
// ↑ 首行不可删：VS Code 的 Prisma 扩展**按文件**判定是否启用 Prisma 7 语言服务，
// 缺失会回落到 v6 语义并误报 `Argument "url" is missing in data source block "db"`。
//
// 「短句」业务域：客户端用户 / 场景分类 / 句子题库 / 生成批次 / 答题记录 /
// 收藏 / 打卡 / AI 调用日志。
// 公共约定（snake_case 映射 / 哨兵值 / 注释落库）见 base.prisma。

/// 客户端用户（与后台 sys_user 彻底隔离，独立鉴权体系）
model ClientUser {
  /// 主键
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  /// 登录邮箱（唯一）
  email             String    @unique @db.VarChar(100)
  /// bcrypt 口令哈希（与后台同策略，见 common/auth/password-policy.ts）
  password          String    @db.VarChar(100)
  /// 昵称
  nickname          String    @db.VarChar(50)
  /// 头像文件 id（0 = 默认头像，故不建外键）
  avatarFileId      BigInt    @default(0) @map("avatar_file_id") @db.BigInt
  /// 出生年月日
  birthday          DateTime? @db.Date
  /// 性别：male 男 / female 女 / secret 保密
  gender            String    @default("secret") @db.VarChar(10)
  /// 个性签名
  signature         String?   @db.VarChar(200)
  /// 个人主页背景句签 id（0 = 未设置，用默认品牌渐变；须为本人已获得的句签）
  bgCardId          BigInt    @default(0) @map("bg_card_id") @db.BigInt
  /// 累计经验值（只增不减；由 gamify 服务端按事件发放，幂等账本见 gamify.prisma）
  xp                Int       @default(0) @db.Int
  /// 1 启用 / 0 禁用
  status            Int       @default(1) @db.TinyInt
  /// 每日学习提醒邮件：1 订阅 / 0 不订阅（用户主动开启才发，即视为同意接收）
  emailReminder     Int       @default(0) @map("email_reminder") @db.TinyInt
  /// 每周学习报告邮件：1 订阅 / 0 不订阅（用户主动开启才发，与每日提醒独立）
  weeklyReportEmail Int       @default(0) @map("weekly_report_email") @db.TinyInt
  /// 最后登录时间
  lastLoginAt       DateTime? @map("last_login_at")
  /// 密码最后修改时间（改密后旧 Token 失效判定）
  passwordChangedAt DateTime? @map("password_changed_at")
  /// 创建时间
  createdAt         DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt         DateTime  @updatedAt @map("updated_at")
  /// 微信小程序 openid（唯一；用于微信一键登录；注销/解绑后置空）
  wechatOpenid      String?   @unique @map("wechat_openid") @db.VarChar(64)
  /// 微信 unionid（同主体跨应用统一；可选）
  wechatUnionid     String?   @map("wechat_unionid") @db.VarChar(64)
  /// 注销时间（软删；非空表示已注销，令牌与微信登录均失效）
  deletedAt         DateTime? @map("deleted_at")

  // 答题记录 / 收藏 / 打卡不声明 Prisma 关系：与 sys_user.dept_id 的哨兵约定一致，
  // 一律按 userId 显式查询（见 base.prisma「哨兵值约定」），删除用户时由业务层清理。

  @@index([status])
  @@map("client_user")
}

/// 场景分类（题目的主题归类，如「咖啡店点单」「机场通关」）
model SentenceCategory {
  /// 主键
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  /// 分类名称（中文）
  name      String   @db.VarChar(50)
  /// 分类名称（英文，卡片副标题用）
  nameEn    String?  @map("name_en") @db.VarChar(50)
  /// 图标（bootstrap-icons 类名）
  icon      String?  @db.VarChar(100)
  /// 封面图文件 id（0 = 无封面；指向 sys_file）。一字段两用：节日分类 = 节日题库封面；
  /// 普通分类 = 情景闯关「场景」封面（节日分类不进闯关地图，互不冲突）
  coverFileId BigInt @default(0) @map("cover_file_id") @db.BigInt
  /// 排序（升序）
  sort      Int      @default(0)
  /// 1 启用 / 0 禁用
  status    Int      @default(1) @db.TinyInt
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  sentences Sentence[]

  @@map("sentence_category")
}

/// 句子题库（图片由定时任务预生成，status=ready 才下发用户端）
model Sentence {
  /// 主键
  id               BigInt   @id @default(autoincrement()) @db.BigInt
  /// 所属分类
  categoryId       BigInt   @map("category_id") @db.BigInt
  /// 难度：1 易 / 2 中 / 3 难
  difficulty       Int      @default(1) @db.TinyInt
  /// 英文句子（唯一；批量生成的天然去重键）
  sentenceEn       String   @unique @db.VarChar(300)
  /// 其他可接受的英文表达（JSON 数组，最多 5 条；输入模式下用户写出任一条即算对）
  alternateAnswers String?  @map("alternate_answers") @db.VarChar(1000)
  /// 中文释义（用户端题干）
  translationZh    String   @map("translation_zh") @db.VarChar(300)
  /// IPA 音标（英美合并，如 /ˈkɒfi ˈplez/）
  ipa              String?  @db.VarChar(200)
  /// 题目解析（中文：语法点 / 时态语态 / 关键词形与搭配 / 易错点）。
  /// 答题后**无论对错都展示**，帮用户理解为什么这么写；运营手工创建的题可留空。
  explanation      String?  @db.VarChar(500)
  /// 选词模式逐词释义（JSON 对象：词 → 该词在本句中的中文含义，如 {"coffee":"咖啡"}）。
  /// 新题在生成流水线「逐词释义」阶段产出；旧题为 null（用户端不显示悬浮提示）。
  wordMeanings     String?  @map("word_meanings") @db.Text
  /// 生图提示词（描述「两人对话场景」构图，供运营审核）
  scenePrompt      String   @map("scene_prompt") @db.VarChar(500)
  /// 配图文件 id（0 = 未生成，指向 sys_file；故不建外键）
  imageFileId      BigInt   @default(0) @map("image_file_id") @db.BigInt
  /// 来源：ai 生成 / manual 运营手工
  source           String   @default("ai") @db.VarChar(20)
  /// AI 生成时实际使用的文本模型配置 id（模型列表项；null = 旧数据或手工题，不展示）
  aiChannel        String?  @map("ai_channel") @db.VarChar(20)
  /// AI 生成时实际使用的文本模型名（如 gpt-4o-mini / deepseek-v4.1-flash；null 同上）
  aiModel          String?  @map("ai_model") @db.VarChar(100)
  /// 状态：pending_image 待生成 / ready 就绪 / offline 下架
  status           String   @default("pending_image") @db.VarChar(20)
  /// 所属生成批次 id（0 = 手工创建）
  genTaskId        BigInt   @default(0) @map("gen_task_id") @db.BigInt
  /// 节日题库：所属节日名（如「春节」；普通题为 null）
  festivalName     String?  @map("festival_name") @db.VarChar(50)
  /// 节日题库：该次节日的公历日期（YYYY-MM-DD）。同一节日不同年份靠它区分新旧批次
  festivalDate     String?  @map("festival_date") @db.VarChar(10)
  /// 退场时间（非空 = 不再出现在练习流；旧节日题库在新一期生成成功后置位）
  retiredAt        DateTime? @map("retired_at")
  /// 创建时间
  createdAt        DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime @updatedAt @map("updated_at")

  category  SentenceCategory   @relation(fields: [categoryId], references: [id])
  records   SentenceRecord[]
  favorites SentenceFavorite[]
  reports   SentenceReport[]

  @@index([status, categoryId])
  @@index([status, retiredAt])
  @@index([festivalName, festivalDate])
  @@index([genTaskId])
  @@map("sentence")
}

/// 每日生成批次（一条 = 一天的批量任务）
model SentenceGenTask {
  /// 主键
  id              BigInt    @id @default(autoincrement()) @db.BigInt
  /// 业务日期（YYYY-MM-DD 字符串）。
  /// 配合 categoryId 组成复合唯一：一天内可同时存在「一个定时全量批次（categoryId=0）」
  /// 与「多个按分类定向补题批次（categoryId=对应分类 id）」，互不冲突——这正是「填场景」要的能力。
  bizDate         String    @map("biz_date") @db.VarChar(10)
  /// 定向补题的分类 id：0 = 定时全量批次（哨兵），其余为对应分类的定向补题批次。
  /// 仅用于批次维度区分与监控展示，题目最终归属由生题流水线的 targetCategory 决定。
  categoryId      BigInt    @default(0) @map("category_id") @db.BigInt
  /// 目标生成数量
  targetCount     Int       @default(0) @map("target_count")
  /// 文本已生成数量
  textDone        Int       @default(0) @map("text_done")
  /// 图片已生成数量
  imageDone       Int       @default(0) @map("image_done")
  /// 失败数量（文本+图片合计）
  failCount       Int       @default(0) @map("fail_count")
  /// 状态：pending 待处理 / running 进行中 / success 成功 / failed 失败
  status          String    @default("pending") @db.VarChar(20)
  /// 当前阶段：generating 生题 / polishing 优化 / reviewing 审核 / annotating 逐词释义 / imaging 生图 / done 收尾
  stage           String    @default("") @db.VarChar(20)
  /// 最近心跳（每完成一批题/一张图更新）：前端据此区分「还在跑」与「卡住了」
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  /// 触发方式：cron 定时 / manual 手动
  triggerType     String    @default("cron") @map("trigger_type") @db.VarChar(20)
  /// 本批是否为节日题库：节日名（null = 普通批次）
  festivalName    String?   @map("festival_name") @db.VarChar(50)
  /// 节日日期（YYYY-MM-DD）；与 festivalName 一起标识「哪一年的哪个节日」
  festivalDate    String?   @map("festival_date") @db.VarChar(10)
  /// 失败原因摘要（截断到 500 字符）
  errorMessage    String?   @map("error_message") @db.VarChar(500)
  /// 开始时间
  startedAt       DateTime? @map("started_at")
  /// 结束时间
  finishedAt      DateTime? @map("finished_at")
  /// 创建时间
  createdAt       DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// 一天内同一分类最多一个批次（categoryId=0 表示定时全量批次，同样唯一）
  @@unique([bizDate, categoryId])
  @@index([categoryId])
  @@map("sentence_gen_task")
}

/// 答题记录（一行 = 一次作答；复习池由 isCorrect=0 且 nextReviewAt<=now 派生，不另建表）
model SentenceRecord {
  /// 主键
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  /// 用户 id
  userId       BigInt    @map("user_id") @db.BigInt
  /// 句子 id
  sentenceId   BigInt    @map("sentence_id") @db.BigInt
  /// 用户当次输入（截断到 300）
  userAnswer   String    @map("user_answer") @db.VarChar(300)
  /// 是否正确：1 是 / 0 否
  isCorrect    Int       @default(0) @map("is_correct") @db.TinyInt
  /// 作答耗时（毫秒）
  elapsedMs    Int       @default(0) @map("elapsed_ms") @db.Int
  /// 间隔重复等级：0=陌生，每答对一次 +1（对应 1/3/7/15/30 天）
  reviewLevel  Int       @default(0) @map("review_level") @db.TinyInt
  /// 下次复习时间（null = 未排期，如首次答对安排 +1 天）
  nextReviewAt DateTime? @map("next_review_at")
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")

  sentence Sentence @relation(fields: [sentenceId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, sentenceId])
  /// 复习池查询：某用户的错题按到期时间升序
  @@index([userId, isCorrect, nextReviewAt])
  @@map("sentence_record")
}

/// 收藏夹
model SentenceFavorite {
  /// 主键
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  /// 用户 id
  userId     BigInt   @map("user_id") @db.BigInt
  /// 句子 id
  sentenceId BigInt   @map("sentence_id") @db.BigInt
  /// 创建时间
  createdAt  DateTime @default(now()) @map("created_at")

  sentence Sentence @relation(fields: [sentenceId], references: [id])

  /// 同一用户对同一句子只能收藏一次
  @@unique([userId, sentenceId])
  @@map("sentence_favorite")
}

/// 题目举报/反馈（用户端「举报」按钮提交，供运营核查处理）
model SentenceReport {
  /// 主键
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  /// 举报人用户 id（client_user）
  userId      BigInt    @map("user_id") @db.BigInt
  /// 被举报句子 id
  sentenceId  BigInt    @map("sentence_id") @db.BigInt
  /// 举报类型：wrong 题目/翻译有误 / inappropriate 内容不适当 / image 图片不雅 / other 其他
  reason      String    @db.VarChar(20)
  /// 补充描述（可选）
  description String?   @db.VarChar(500)
  /// 处理状态：pending 待处理 / resolved 已处理 / dismissed 已驳回
  status      String    @default("pending") @db.VarChar(20)
  /// 处理备注（运营填写）
  handleNote  String?   @map("handle_note") @db.VarChar(500)
  /// 处理时间
  handledAt   DateTime? @map("handled_at")
  /// 创建时间
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sentence Sentence @relation(fields: [sentenceId], references: [id])

  @@index([status, createdAt])
  @@index([sentenceId])
  @@index([userId, createdAt])
  @@map("sentence_report")
}

/// 每日打卡（一行 = 一个用户一天的完成记录）
model UserCheckin {
  /// 主键
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  /// 用户 id
  userId       BigInt   @map("user_id") @db.BigInt
  /// 打卡日期（YYYY-MM-DD 字符串）
  checkinDate  String   @map("checkin_date") @db.VarChar(10)
  /// 当日完成题数
  doneCount    Int      @default(0) @map("done_count")
  /// 当日目标题数
  goalCount    Int      @default(0) @map("goal_count")
  /// 连续打卡天数（截止本次）
  streak       Int      @default(1) @db.TinyInt
  /// 打卡海报文件 id（0 = 未生成；海报在前端 html2canvas 生成，一般留空）
  posterFileId BigInt   @default(0) @map("poster_file_id") @db.BigInt
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")

  /// 同一用户同一天只允许一条打卡
  @@unique([userId, checkinDate])
  @@map("user_checkin")
}

/// AI 调用日志（生题/生图/造句/词根，计费与排障依据）
model AiCallLog {
  /// 主键
  id               BigInt   @id @default(autoincrement()) @db.BigInt
  /// 调用类型：sentence_gen 生题 / sentence_polish 优化 / sentence_review 审核 / word_meanings 逐词释义 / sentence_card_gen 句签 / image_gen 生图 / expand 造句 / word_root 词根
  type             String   @db.VarChar(20)
  /// 提供方（模型配置 id，如 text-1；历史值可能是 nvidia / agnes-ai）
  provider         String   @db.VarChar(50)
  /// 模型标识（如 gpt-4o-mini / deepseek-v4.1-flash）
  model            String   @db.VarChar(100)
  /// 关联业务 id（批次/句子/用户，按类型解释）
  bizId            BigInt   @default(0) @map("biz_id") @db.BigInt
  /// 输入 token 数（生题类）
  promptTokens     Int      @default(0) @map("prompt_tokens")
  /// 输出 token 数
  completionTokens Int      @default(0) @map("completion_tokens")
  /// 耗时（毫秒）
  latencyMs        Int      @default(0) @map("latency_ms")
  /// 状态：success / failed
  status           String   @default("success") @db.VarChar(20)
  /// 错误摘要（截断到 500 字符）
  errorMessage     String?  @map("error_message") @db.VarChar(500)
  /// 创建时间
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([bizId])
  @@map("ai_call_log")
}
