NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ly_admin
DB_USER=root
DB_PASSWORD=your_password
# 可选：直接给出完整连接串（优先级高于上面的 DB_*，供 Prisma CLI 使用）。
# Prisma 7 的 schema 不再接受 datasource.url，连接串统一由 prisma.config.ts 提供；
# 未设置本项时，prisma.config.ts 会用 DB_* 拼装（密码走 encodeURIComponent，特殊字符安全）。
# DATABASE_URL=mysql://root:your_password@localhost:3306/ly_admin
# 是否记录 Prisma 查询事件（用于慢 SQL 日志 db-*.log）
DB_LOGGING=true
# 连接池上限（默认 10，范围 1~100）
DB_CONNECTION_LIMIT=10

# JWT 密钥（必填，缺失或为空将拒绝启动；两个密钥必须互不相同）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 严禁使用任何可预测的默认值。
JWT_ACCESS_SECRET=<必填：32 字节随机 hex>
JWT_REFRESH_SECRET=<必填：32 字节随机 hex>
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ── 登录图形验证码 ──
# 是否启用登录图形验证码（默认 true）；设 false 可关闭（如自动化测试环境）
CAPTCHA_ENABLED=true
# 验证码有效期（ms，默认 5 分钟）
# CAPTCHA_TTL_MS=300000
# 验证码字符数（默认 4）
# CAPTCHA_LENGTH=4

# 反向代理信任跳数（仅当部署在反向代理之后才设置，值=代理跳数，如 1；默认不设置=不信任 X-Forwarded-For）
# TRUST_PROXY=1

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_COUNT=10
# 图片缩放缓存目录（相对项目根，默认 cache/images）。
# 注意：必须位于 UPLOAD_DIR 之外，否则缓存文件会被静态服务公开访问。
# UPLOAD_CACHE_DIR=cache/images

# 防盗链 Referer 白名单（逗号分隔；可写 origin 或裸 host）。
# 放行规则：无 Referer、与请求同源、命中本白名单之一；其余返回 403。
# 同源部署（后端托管前端产物）时无需配置；
# 前后端分离部署必须把前端 origin 配进来，否则静态资源被判为外链。
# 开发期两个前端并存：admin :5173、client :3001（client 固定 3001，见 client/nuxt.config.ts）。
UPLOAD_ALLOWED_REFERERS=http://localhost:5173,http://localhost:3001

CORS_ORIGIN=http://localhost:5173,http://localhost:3001
LOG_DIR=logs

# 归档根目录（可选，默认 <LOG_DIR>/archive）
# LOG_ARCHIVE_DIR=logs/archive
# 归档时刻（本地时间，默认次日 00:05 归档昨日）
LOG_ARCHIVE_HOUR=0
LOG_ARCHIVE_MINUTE=5
# 归档成功后是否保留源 .log（默认 false=删除）
LOG_ARCHIVE_KEEP_SOURCE=false
# 慢 SQL 阈值（ms）
LOG_SLOW_SQL_MS=200
# 自定义 tar 可执行文件（默认 PATH 中的 tar）
# TAR_BIN=tar

# ── 日志保留策略（按时间列分批 DELETE 自动清理，每日 00:10 触发；单位：天）──
# 保留天数须为**正整数**：设为 0 / 负数 / 非法值时将被拒绝、回退默认值并打印告警（防"0=清空整表"事故）。
# HTTP 访问日志（sys_http_log）保留天数：默认 7。该表是磁盘增长主源，取证价值随时间快速衰减。
LOG_HTTP_RETENTION_DAYS=7
# 操作日志（sys_operation_log）保留天数：默认 180。审计证据，需长期保留。
LOG_OPERATION_RETENTION_DAYS=180
# 登录日志（sys_login_log）保留天数：默认 180（折中）。
LOG_LOGIN_RETENTION_DAYS=180
# 保留清理触发时刻（本地时间，默认 00:10，刻意避开 00:05 归档以避免同一时刻抢 IO）
LOG_RETENTION_HOUR=0
LOG_RETENTION_MINUTE=10
# 是否启用日志保留清理：默认 true；设 false 为紧急刹车（不注册调度器、不执行清理）
LOG_RETENTION_ENABLED=true

# ── Redis（登出令牌黑名单 / 登录频率限制 / 验证码的共享存储）──
# 用途：① 退出登录后服务端立即失效旧令牌（黑名单）；② 登录频率限制跨进程/跨实例共享计数；③ 验证码跨实例共享。
# 降级：留空 REDIS_HOST 即视为不启用——登录与鉴权主流程不受影响，仅上述增强失效。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码可留空；有密码时填写
# REDIS_PASSWORD=
REDIS_DB=0

# ── IP 黑名单（防单 IP 批量注册 / 登录爆破的兜底闸门；默认关闭）──
# 总开关：默认 false（绝不默认开启，避免误封公司/学校等共享出口 IP 下的正常用户）。
# 开启前请确认阈值留足余量；异常时（Redis/DB 故障）自动降级放行，不会阻断全站。
# IP_BAN_ENABLED=true
# 单 IP 自然日内注册接口调用次数上限（含验证码失败；正常用户只注册 1 次），超过即自动封禁。默认 30
# IP_BAN_DAILY_REGISTER_LIMIT=30
# 自动封禁时长（小时，默认 24；0 表示永久）。默认 24
# IP_BAN_AUTO_BAN_HOURS=24
# 单 IP 在攻击窗口内登录失败次数上限（检测爆破/枚举），超过即自动封禁。默认 50
# IP_BAN_LOGIN_FAIL_LIMIT=50
# 单 IP 在攻击窗口内验证码失败次数上限，超过即自动封禁。默认 50
# IP_BAN_CAPTCHA_FAIL_LIMIT=50
# 攻击计数滑动窗口（ms，默认 60000 = 60s，与限流窗口一致）
# IP_BAN_ATTACK_WINDOW_MS=60000

# ── AI 能力（「短句」题库生成；密钥只在本文件，绝不下发前端）──
# Agnes AI（生文 + 生图共用同一入口与密钥；模型不同）
# 生文：agnes-2.5-flash（OpenAI 兼容 chat/completions，用于生题/造句/词根/句签文案）
AI_AGNES_TEXT_MODEL=agnes-2.5-flash
# 生图：对话场景图（16:9 2K 档输出 2624x1472）
AI_AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AI_AGNES_API_KEY=
AI_AGNES_MODEL=agnes-image-2.5-flash
# 并发与重试（信号量控制，防上游 429）
AI_TEXT_CONCURRENCY=2
# 生图并发：Agnes 免费额度限流严格，实测 6 会持续 429，2 稳定
AI_IMAGE_CONCURRENCY=2
AI_MAX_ATTEMPTS=3
# 单次 AI 请求超时（生题单批 20 条约 40~70s，生图约 25s；180s 会误杀生题，放宽到 5 分钟）
AI_REQUEST_TIMEOUT_MS=300000
# 全局每日 AI 预算闸门（跨所有调用方：批次生题/生图 + 客户端造句/词根 + 句签）
# 0 = 不限制（默认）；任一维度达上限即暂停所有 AI 调用，次日 0 点恢复
AI_DAILY_CALL_BUDGET=0
# 每日 token 上限（输入 + 输出合计；0 = 不限制），作为防「单次超长输出」的辅助上限
AI_DAILY_TOKEN_BUDGET=0

# ── 「短句」业务 ──
# 每日批量生成目标题数（00:00 定时执行，见 SENTENCE_CRON_*）
# 生产规格 300；测试/调试阶段可设 100 以缩短首轮生成耗时（生图受上游限流约 3~4 分钟/20 张）
SENTENCE_DAILY_TARGET=300
# 用户每日目标题数（打卡完成线）
SENTENCE_DAILY_GOAL=20
SENTENCE_CRON_ENABLED=true
SENTENCE_CRON_HOUR=0
SENTENCE_CRON_MINUTE=0
# 配图参数：16:9 卡片图，2K 档；入库前缩放 + webp 压缩
SENTENCE_IMAGE_SIZE=2K
SENTENCE_IMAGE_RATIO=16:9
SENTENCE_IMAGE_MAX_WIDTH=1280
SENTENCE_IMAGE_QUALITY=80
# 抽题策略：新题占比（其余混入到期复习题）；防重窗口（最近 N 次答过不再出）
SENTENCE_NEW_RATIO=0.8
SENTENCE_ANTI_REPEAT_WINDOW=10
# 节日题库：每个节日题库的目标题数（旧题库在新一期生成成功后整体退场，不再进练习流）
SENTENCE_FESTIVAL_TARGET=100
# 关闭后节日当天按普通批次生成，不做节日标记
SENTENCE_FESTIVAL_ENABLED=true
# 用户答题历史保留天数（不论对错，默认 30 天；0 = 不清理）
SENTENCE_RECORD_RETENTION_DAYS=30
# 是否启用答题历史物理清理（关掉只停删除，历史列表仍按保留天数过滤）
SENTENCE_RECORD_RETENTION_ENABLED=true
