# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
# 构建验证用的临时输出目录（如 vite build --outDir dist-csscheck）
dist-*/
build/
*.local

# 例外：Vditor 自托管静态资源必须入库 —— 否则他人 clone 后构建产物中缺少该目录，
# 编辑器将无法离线渲染（emoji / 内容主题 / 代码高亮 / KaTeX / mermaid）。
!admin/public/vditor/dist/

# Nuxt 客户端（client/）生成产物与运行时数据
.nuxt/
.output/
.data/
client/dist

# Flutter（android/）构建产物与本地配置
android/.dart_tool/
android/.packages
android/build/
android/.idea/
android/android/.gradle/
android/android/local.properties
android/*.iml

# Logs（运行时日志目录用精确路径：`logs/` 通配会误伤 src/modules/logs/ 源码目录，
# 使 ripgrep / 编辑器全局搜索跳过整个日志模块）
api/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

# Uploads (keep directory, ignore content)
api/uploads/*
!api/uploads/.gitkeep

# 后端运行时产物：图片处理缓存（缩略图等）与前端构建产物映射目录（同源部署时由后端托管）
api/cache/
api/web/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
coverage/
*.tsbuildinfo
.eslintcache
.stylelintcache

# AI 助手本地工作数据（会话记忆、Skills 等，不属于项目源码）
.workbuddy-ai/
.workbuddy/
.agents/
