# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
# 构建验证用的临时输出目录（如 vite build --outDir dist-csscheck）
dist-*/
build/
*.local

# Nuxt 客户端（client-web/）生成产物与运行时数据
.nuxt/
.output/
.data/
client-web/dist

# Flutter（client-android/）构建产物与本地配置
client-android/.dart_tool/
client-android/.packages
client-android/build/
client-android/.idea/
client-android/android/.gradle/
client-android/android/local.properties
client-android/*.iml
# Flutter 工具链生成物（.flutter-plugins 由 `flutter pub get` 依本机插件生成，与本机环境相关）
client-android/.flutter-plugins
client-android/.flutter-plugins-dependencies
# Android Studio / Gradle 的本机工程文件（flutter create 会生成 .iml，属 IDE 私有配置）
client-android/android/*.iml
# Android 发布签名密钥与配置（含明文密码，绝不入库；发版机本地放置于 client-android/android/）
client-android/android/key.properties
client-android/android/release-keystore.jks

# 更名残留：原 android/ Flutter 工程已迁至 client-android/，此顶层 android/ 是重复目录。
# 注意：发布签名密钥 release-keystore.jks 仅存于此目录，切勿删除；仅忽略不入库。
/android/

# Logs（运行时日志目录用精确路径：`logs/` 通配会误伤 src/modules/logs/ 源码目录，
# 使 ripgrep / 编辑器全局搜索跳过整个日志模块）
api/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

# Uploads (keep directory, ignore content)
api/uploads/*
!api/uploads/.gitkeep
# 成就 AI 大图目录：保留占位（图片本身仍被上面的规则忽略），保证同源部署时目录存在
!api/uploads/achievements/
api/uploads/achievements/*
!api/uploads/achievements/.gitkeep

# 后端运行时产物：图片处理缓存（缩略图等）与前端构建产物映射目录（同源部署时由后端托管）
api/cache/
api/web/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
coverage/
*.tsbuildinfo
.eslintcache
.stylelintcache

# AI 助手本地工作数据（会话记忆、Skills 等，不属于项目源码）
.workbuddy-ai/
.workbuddy/
.agents/

# 数据备份文件（含用户数据，仅本地留档，不入库）
api/.card-backup-*.json
backups/
*.sql.gz
*.sql
# 例外：Prisma 迁移 SQL 是源码（上面 *.sql 只针对本地数据备份/临时导出）
!api/prisma/migrations/**/*.sql
