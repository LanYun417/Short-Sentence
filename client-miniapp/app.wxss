/**
 * 全局样式与设计令牌。
 *
 * 与 Web 端（client-web）保持同一套语义：sky 为主色、slate 为中性色；
 * 小程序不引入 Tailwind，令牌以 CSS 变量 + 原子类的方式手写，避免构建期依赖。
 */
page {
  --brand: #0ea5e9;
  --brand-light: #38bdf8;
  --brand-soft: #e0f2fe;
  --ink: #0f172a;
  --ink-2: #475569;
  --ink-3: #94a3b8;
  --line: #e8eef6;
  --surface: #ffffff;
  --bg: #f5f7fb;
  --success: #10b981;
  --danger: #ef4444;
  --warning: #f59e0b;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button,
image,
scroll-view {
  box-sizing: border-box;
}

/* ---------------- 布局 ---------------- */

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
  min-width: 0;
}

.gap-8 {
  gap: 8rpx;
}

.gap-16 {
  gap: 16rpx;
}

.gap-24 {
  gap: 24rpx;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

/* ---------------- 卡片 ---------------- */

.card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.card-flat {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 32rpx;
  border: 2rpx solid var(--line);
}

/* ---------------- 文字 ---------------- */

.title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: 600;
}

.body {
  font-size: 28rpx;
  color: var(--ink-2);
}

.muted {
  font-size: 24rpx;
  color: var(--ink-3);
}

.mono {
  font-variant-numeric: tabular-nums;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------------- 按钮 ---------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 40rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand), var(--brand-light));
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(14, 165, 233, 0.28);
}

.btn-ghost {
  background: var(--surface);
  color: var(--ink);
  border: 2rpx solid var(--line);
}

.btn-disabled {
  background: #cbd5e1;
  color: #ffffff;
  box-shadow: none;
}

.btn-block {
  width: 100%;
}

/* ---------------- 徽标 / 标签 ---------------- */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: #0284c7;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-amber {
  background: #fef3c7;
  color: #b45309;
}

.badge-slate {
  background: #f1f5f9;
  color: var(--ink-2);
}

/* ---------------- 进度条 ---------------- */

.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand), var(--brand-light));
  transition: width 0.4s ease;
}

/* ---------------- 头像 ---------------- */

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #bae6fd, #7dd3fc);
  color: #0369a1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

/* ---------------- 分隔 ---------------- */

.divider {
  height: 2rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ---------------- 安全区 ---------------- */

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------------- 通用：分段 tab ---------------- */

.tabs {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  background: #eef2f7;
  border-radius: 20rpx;
}

.tab {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  text-align: center;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.tab-active {
  color: #0284c7;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

/* ---------------- 通用：列表 ---------------- */

.list-card {
  margin-top: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.list-row {
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid #f4f7fb;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row-hover {
  background: #f8fafc;
}

/* ---------------- 通用：chip ---------------- */

.chip {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}

.chip-active {
  color: #0284c7;
  background: var(--brand-soft);
  border-color: var(--brand);
}

/* ---------------- 通用：空状态与页脚 ---------------- */

.empty {
  padding: 120rpx 0;
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
}

.page-foot {
  display: block;
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
}

/* ---------------- 动效系统 ---------------- */

/*
 * 小程序不能引第三方动画库，这里用 CSS keyframes 手写一套。
 * 统一约定：
 * - 入场用 fade-up（位移 28rpx，够明显但不晃）；
 * - 强调用 pop（带回弹的缩放），配 cubic-bezier(0.34, 1.56, 0.64, 1)；
 * - 所有动画都 `both`，配合 .d1~.d6 延迟做错峰；
 * - 需要按压反馈的元素挂 `hover-class="press-hover"`，不要同时挂 anim-*（transform 会打架）。
 */

@keyframes ss-fade-up {
  from {
    opacity: 0;
    transform: translate3d(0, 28rpx, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes ss-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ss-pop {
  0% {
    opacity: 0;
    transform: scale(0.86);
  }
  62% {
    opacity: 1;
    transform: scale(1.04);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 高光扫过：主按钮与进度条上的那道亮 */
@keyframes ss-sheen {
  0% {
    transform: translateX(-160%) skewX(-16deg);
  }
  55%,
  100% {
    transform: translateX(260%) skewX(-16deg);
  }
}

/* 背景光斑的呼吸 */
@keyframes ss-breathe {
  0%,
  100% {
    opacity: 0.4;
    transform: scale(1);
  }
  50% {
    opacity: 0.72;
    transform: scale(1.08);
  }
}

/* 骨架屏 */
@keyframes ss-shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.anim-up {
  animation: ss-fade-up 0.52s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.anim-fade {
  animation: ss-fade-in 0.45s ease both;
}

.anim-pop {
  animation: ss-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* 错峰延迟（配合 anim-* 使用） */
.d1 {
  animation-delay: 60ms;
}

.d2 {
  animation-delay: 120ms;
}

.d3 {
  animation-delay: 180ms;
}

.d4 {
  animation-delay: 240ms;
}

.d5 {
  animation-delay: 300ms;
}

.d6 {
  animation-delay: 360ms;
}

/* 按压反馈 */
.press {
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}

.press-hover {
  transform: scale(0.965);
  opacity: 0.94;
}

/* 骨架条 */
.skeleton {
  background: linear-gradient(90deg, #eef2f7 25%, #f8fafc 37%, #eef2f7 63%);
  background-size: 400% 100%;
  border-radius: 16rpx;
  animation: ss-shimmer 1.4s ease infinite;
}

/* 渐变文字（大数字/等级名用） */
.grad-text {
  background: linear-gradient(120deg, #ffffff, #e0f2fe);
  background-clip: text;
  color: transparent;
  -webkit-background-clip: text;
}

/* 柔和卡片：比 .card 更轻的阴影，适合列表项 */
.surface {
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.05);
}
