.practice {
  min-height: 100vh;
  padding: 16rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  /* 顶部一层极淡的品牌色，卡片下方的留白不至于死灰 */
  background: linear-gradient(180deg, #f2f9ff 0%, var(--bg) 46%);
}

/* 卡片入场：放在 .flip 这层（内层有 3D transform，动画挂上去会打架） */
.flip {
  animation: ss-fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* 输入框聚焦：底色提亮 + 品牌色描边 */
.q-input-focus {
  background: #ffffff;
  border-color: var(--brand);
  box-shadow: 0 0 0 6rpx rgba(14, 165, 233, 0.12);
}

.foot-hint {
  margin-top: 36rpx;
  text-align: center;
}

/* ---------------- 顶部条 ---------------- */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  font-size: 44rpx;
  line-height: 1;
  color: var(--ink-2);
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.back-hover {
  opacity: 0.7;
}

.modes {
  display: flex;
  padding: 4rpx;
  background: #eef2f7;
  border-radius: 999rpx;
}

.mode {
  padding: 10rpx 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  border-radius: 999rpx;
  transition: all 0.2s ease;
}

.mode-active {
  color: #0284c7;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.progress {
  min-width: 96rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #0284c7;
  text-align: center;
  background: var(--brand-soft);
  border-radius: 999rpx;
}

.progress-placeholder {
  width: 96rpx;
}

.progress-line {
  height: 6rpx;
  margin-top: 8rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.progress-line-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand), var(--brand-light));
  border-radius: 999rpx;
  transition: width 0.45s ease;
}

/* ---------------- 加载 / 错误 ---------------- */

.center-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  text-align: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------------- 3D 翻转 ---------------- */

.flip {
  margin-top: 24rpx;
  perspective: 1800rpx;
}

/*
 * 两面用 grid 叠在同一格：容器高度取两面较高者，
 * 避免 absolute + 固定高度导致的「背面内容被裁」。
 */
.flip-inner {
  display: grid;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.flip-inner.is-flipped {
  transform: rotateY(180deg);
}

.face {
  grid-area: 1 / 1;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.face-back {
  transform: rotateY(180deg);
}

.flip-inner.is-flipped .face-front {
  pointer-events: none;
}

/* ---------------- 正面 ---------------- */

/* 固定 16:9 视窗 + aspectFill：不依赖 widthFix 推算高度，
   图片未加载完也不会让卡片跳动（widthFix 在部分环境里不绘制）。 */
.q-image {
  display: block;
  width: 100%;
  height: 348rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
}

.q-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.q-translation {
  display: block;
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink);
  letter-spacing: -0.5rpx;
}

.q-input {
  width: 100%;
  height: 104rpx;
  margin-top: 32rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--ink);
  background: #f6f8fb;
  border: 2rpx solid #e8eef6;
  border-radius: 24rpx;
}

.q-input-ph {
  color: var(--ink-3);
}

/* 拼词模式 */
.picked {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  min-height: 120rpx;
  margin-top: 32rpx;
  padding: 20rpx;
  background: #f6f8fb;
  border: 2rpx dashed #cbd5e1;
  border-radius: 24rpx;
}

.picked-hint {
  font-size: 24rpx;
  color: var(--ink-3);
}

.picked-word {
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  color: #0284c7;
  background: var(--brand-soft);
  border-radius: 14rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.chip {
  padding: 14rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  transition: all 0.15s ease;
}

.chip-used {
  color: #cbd5e1;
  background: #f8fafc;
  border-color: #f1f5f9;
}

.submit {
  margin-top: 40rpx;
}

/* ---------------- 背面 ---------------- */

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-radius: 22rpx;
}

.result-head.ok {
  background: #ecfdf5;
}

.result-head.bad {
  background: #fef2f2;
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
}

.result-head.ok .result-title {
  color: #047857;
}

.result-head.bad .result-title {
  color: #b91c1c;
}

.result-xp {
  padding: 6rpx 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #b45309;
  background: #fef3c7;
  border-radius: 999rpx;
}

.block {
  margin-top: 28rpx;
}

.block-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.answer-en {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
}

.answer-ipa {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.answer-alt {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.answer-note {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.achievement {
  display: block;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #b45309;
  background: #fffbeb;
  border-radius: 16rpx;
}

.result-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.fav {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: #f6f8fb;
  border-radius: 999rpx;
}

.next {
  margin-top: 24rpx;
}
