.vip-page {
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

/* ---------------- 顶部会员状态 ---------------- */

.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #f59e0b, #f97316 55%, #ef4444);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 48rpx rgba(249, 115, 22, 0.28);
}

.hero-glow {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  filter: blur(28rpx);
}

.hero-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.hero-crown {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
}

.hero-tags {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.hero-tag {
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

/* ---------------- 未开放提示 ---------------- */

.notice {
  margin-top: 28rpx;
  padding: 32rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 24rpx;
}

.notice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
}

.notice-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b45309;
}

/* ---------------- 套餐 ---------------- */

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 4rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.section-hint {
  font-size: 22rpx;
  color: var(--ink-3);
}

.plans {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan {
  position: relative;
  padding: 28rpx 28rpx 24rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.plan-on {
  border-color: #f59e0b;
  box-shadow: 0 12rpx 32rpx rgba(245, 158, 11, 0.16);
}

.plan.skeleton {
  height: 168rpx;
  background: linear-gradient(90deg, #eef2f7 25%, #f8fafc 37%, #eef2f7 63%);
  background-size: 400% 100%;
  animation: ss-shimmer 1.2s ease infinite;
}

@keyframes ss-shimmer {
  from {
    background-position: 100% 50%;
  }

  to {
    background-position: 0 50%;
  }
}

.plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-name {
  font-size: 26rpx;
  color: var(--ink-2);
}

.plan-badge {
  padding: 2rpx 12rpx;
  font-size: 18rpx;
  color: #ffffff;
  background: #f97316;
  border-radius: 999rpx;
}

.plan-price {
  display: block;
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
}

.plan-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.plan-benefits {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 16rpx;
}

.plan-benefit {
  font-size: 22rpx;
  color: var(--ink-2);
}

.plan-check {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: #f59e0b;
  border-radius: 50%;
}

/* ---------------- 购买 ---------------- */

.buy {
  margin-top: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border-radius: 999rpx;
  box-shadow: 0 14rpx 32rpx rgba(249, 115, 22, 0.28);
}

.buy::after {
  border: none;
}

.buy[disabled] {
  opacity: 0.6;
}

.buy-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: center;
}

.ios-tip {
  margin-top: 36rpx;
  padding: 24rpx 28rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #92400e;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 24rpx;
}

.paid {
  margin-top: 32rpx;
  padding: 32rpx;
  text-align: center;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  border-radius: 28rpx;
}

.paid-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #047857;
}

.paid-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #059669;
}

.paid-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 16rpx 56rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: #10b981;
  border-radius: 999rpx;
}

.error {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--danger);
  text-align: center;
}
