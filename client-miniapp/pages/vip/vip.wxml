<view class="page vip-page">
  <!-- 会员状态 -->
  <view class="hero anim-up">
    <view class="hero-glow"></view>
    <view class="hero-row">
      <view class="hero-copy">
        <text class="hero-kicker">短句会员</text>
        <text class="hero-title">{{vipTitle}}</text>
        <text class="hero-sub">{{vipText}}</text>
      </view>
      <view class="hero-crown">VIP</view>
    </view>
    <view class="hero-tags">
      <text class="hero-tag">AI 私教 200 次 / 日</text>
      <text class="hero-tag">弱项画像</text>
      <text class="hero-tag">深度点评</text>
    </view>
  </view>

  <!-- 未开放 / 加载失败 -->
  <view wx:if="{{!loading && !enabled}}" class="notice anim-fade d1">
    <text class="notice-title">会员购买暂未开放</text>
    <text class="notice-sub">支付通道还在接入中，请稍后再来。</text>
  </view>

  <block wx:else>
    <view class="section-head anim-fade d1">
      <text class="section-title">选择套餐</text>
      <text class="section-hint">一次购买 · 到期不自动续费</text>
    </view>

    <view wx:if="{{loading}}" class="plans">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="plan skeleton"></view>
    </view>

    <view wx:else class="plans">
      <view
        wx:for="{{plans}}"
        wx:key="code"
        class="plan anim-up {{item.code === selectedCode ? 'plan-on' : ''}}"
        style="animation-delay: {{60 + index * 60}}ms"
        bindtap="onSelect"
        data-code="{{item.code}}"
      >
        <view class="plan-head">
          <text class="plan-name">{{item.name}}</text>
          <text wx:if="{{item.badge}}" class="plan-badge">{{item.badge}}</text>
        </view>
        <text class="plan-price">¥{{item.priceText}}</text>
        <text class="plan-sub">{{item.subText}}</text>
        <view class="plan-benefits">
          <text wx:for="{{item.benefits}}" wx:for-item="benefit" wx:key="*this" class="plan-benefit">· {{benefit}}</text>
        </view>
        <view wx:if="{{item.code === selectedCode}}" class="plan-check">✓</view>
      </view>
    </view>

    <block wx:if="{{!ios}}">
      <button class="buy press-hover anim-up d3" loading="{{paying}}" disabled="{{paying || !selectedCode}}" bindtap="onBuy">
        微信支付
      </button>
      <text class="buy-hint">支付成功后会员立即到账；如需退款请联系客服。</text>
    </block>
    <view wx:else class="ios-tip anim-fade d2">
      受苹果政策限制，iOS 暂不支持在小程序内购买会员。请用网页版或安卓端开通（会员权益三端通用）。
    </view>

    <view wx:if="{{paid}}" class="paid anim-pop">
      <text class="paid-title">支付成功</text>
      <text class="paid-sub">{{vipText}}</text>
      <view class="paid-btn press-hover" bindtap="onGoPractice">去练一句</view>
    </view>

    <text wx:if="{{errorText}}" class="error">{{errorText}}</text>
  </block>
</view>