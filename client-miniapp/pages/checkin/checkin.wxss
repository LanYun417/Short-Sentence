.poster {
  margin-top: 16rpx;
  padding: 40rpx;
  background: linear-gradient(150deg, #0f172a 0%, #1e293b 46%, #0e7490 100%);
  border-radius: 36rpx;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.3);
}

.poster-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.poster-brand {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

.poster-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.poster-main {
  display: flex;
  align-items: baseline;
  margin-top: 44rpx;
}

.poster-streak {
  font-size: 132rpx;
  font-weight: 800;
  line-height: 1;
  color: #ffffff;
  letter-spacing: -4rpx;
}

.poster-unit {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.poster-bar {
  height: 12rpx;
  margin-top: 44rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.poster-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #22d3ee, #a5f3fc);
  border-radius: 999rpx;
  transition: width 0.5s ease;
}

.poster-meta {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.72);
}

.poster-foot {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.12);
}

.poster-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}
