<view class="page">
  <view class="poster">
    <view class="poster-head">
      <text class="poster-brand">每日一句</text>
      <text class="poster-date">{{checkin.date}}</text>
    </view>

    <view class="poster-main">
      <text class="poster-streak">{{checkin.streak}}</text>
      <text class="poster-unit">天连续打卡</text>
    </view>

    <view class="poster-bar">
      <view class="poster-bar-fill" style="width: {{percent}}%"></view>
    </view>
    <text class="poster-meta">今日 {{checkin.doneCount}} / {{goalText}} 题</text>

    <view class="poster-foot">
      <text class="poster-tip">{{tip}}</text>
    </view>
  </view>

  <button
    class="btn btn-primary btn-block mt-32 {{submitting ? 'btn-disabled' : ''}}"
    bindtap="onCheckin"
  >{{submitting ? '打卡中…' : checkin.completed ? '确认打卡' : '先打个卡'}}</button>

  <button class="btn btn-ghost btn-block mt-16" open-type="share">分享打卡</button>
  <button class="btn btn-ghost btn-block mt-16" bindtap="onGoPractice">继续刷题</button>

  <text class="page-foot">每天坚持一点点，连续天数会一直涨</text>
</view>
