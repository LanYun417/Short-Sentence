.page {
  padding: 32rpx 28rpx 64rpx;
}

.state {
  padding: 120rpx 0;
  text-align: center;
}

.muted {
  font-size: 26rpx;
  color: var(--ink-3);
}

.retry {
  margin-top: 32rpx;
}

.intro {
  padding: 12rpx 0 24rpx;
}

.intro-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
}

.intro-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.intro-btn {
  margin-top: 20rpx;
}

.item-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.item-title-wrap {
  flex: 1;
  min-width: 0;
}

.item-word {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.item-meaning {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.item-count {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  font-size: 21rpx;
  color: #e11d48;
  background: #fff1f2;
  border-radius: 999rpx;
}

.item-root {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--brand);
}

.example {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f4f7fb;
}

.example-img {
  width: 150rpx;
  height: 100rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.example-body {
  flex: 1;
  min-width: 0;
}

.example-zh {
  display: block;
  font-size: 25rpx;
  color: var(--ink);
}

.example-answer {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}
