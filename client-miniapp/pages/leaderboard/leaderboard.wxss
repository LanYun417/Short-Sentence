/* 排行榜：周期 / 指标 / 我的名次 / 领奖台 / 列表 */

/* ---------------- 周期切换：滑动药丸 ---------------- */

.seg {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  background: #eef2f7;
  border-radius: 999rpx;
}

.seg-item {
  flex: 1;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--ink-2);
  text-align: center;
  border-radius: 999rpx;
  transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.seg-active {
  font-weight: 700;
  color: #0284c7;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(14, 165, 233, 0.16);
}

/* ---------------- 指标 ---------------- */

.metrics {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.metric {
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  transition: all 0.2s ease;
}

.metric-active {
  font-weight: 600;
  color: #0284c7;
  background: var(--brand-soft);
  border-color: #bae6fd;
}

/* ---------------- 我的名次 ---------------- */

.me {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
  background: linear-gradient(120deg, #f8fafc, #eef6fd);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
}

/* 上榜后换成暖色，给自己一个视觉回报 */
.me-on {
  background: linear-gradient(120deg, #fff7ed, #ffedd5);
  border-color: #fed7aa;
}

.me-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  font-size: 34rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(180, 83, 9, 0.12);
}

.me-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.me-label {
  font-size: 22rpx;
  color: var(--ink-3);
}

.me-value {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.5rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------------- 领奖台 ---------------- */

.podium {
  display: flex;
  gap: 14rpx;
  align-items: flex-end;
  padding: 32rpx 20rpx 0;
  margin-top: 24rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

/* 冠军位置垫一层暖光，视线先落在第一 */
.podium-1::before {
  position: absolute;
  top: -40rpx;
  left: 50%;
  width: 260rpx;
  height: 260rpx;
  content: '';
  background: radial-gradient(circle, rgba(251, 191, 36, 0.22), rgba(251, 191, 36, 0));
  transform: translateX(-50%);
}

.podium-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.podium-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 700;
  color: #0369a1;
  background: linear-gradient(135deg, #bae6fd, #7dd3fc);
  border-radius: 50%;
  box-shadow:
    0 0 0 6rpx #ffffff,
    0 12rpx 26rpx rgba(15, 23, 42, 0.12);
}

/* 冠军头像更大 + 金色光环 */
.podium-1 .podium-avatar {
  width: 128rpx;
  height: 128rpx;
  font-size: 44rpx;
  box-shadow:
    0 0 0 6rpx #ffffff,
    0 0 0 10rpx rgba(245, 158, 11, 0.32),
    0 16rpx 34rpx rgba(180, 83, 9, 0.22);
}

/* 自己上榜：蓝色光环 */
.podium-me {
  box-shadow:
    0 0 0 6rpx #ffffff,
    0 0 0 10rpx rgba(14, 165, 233, 0.45),
    0 12rpx 26rpx rgba(14, 165, 233, 0.2);
}

.podium-medal {
  position: absolute;
  top: -8rpx;
  left: 50%;
  width: 40rpx;
  height: 40rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 34rpx;
  color: #ffffff;
  text-align: center;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  transform: translateX(-50%);
}

.medal-1 {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
}

.medal-2 {
  background: linear-gradient(135deg, #cbd5e1, #94a3b8);
}

.medal-3 {
  background: linear-gradient(135deg, #fda4af, #fb7185);
}

.podium-name {
  max-width: 100%;
  margin-top: 16rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
}

.podium-count {
  margin-top: 2rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #0284c7;
}

/* 台基：三档高度做出领奖台轮廓 */
.podium-base {
  width: 100%;
  margin-top: 14rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.base-1 {
  height: 92rpx;
  background: linear-gradient(180deg, #fde68a, #fbbf24);
}

.base-2 {
  height: 62rpx;
  background: linear-gradient(180deg, #e2e8f0, #cbd5e1);
}

.base-3 {
  height: 42rpx;
  background: linear-gradient(180deg, #fecdd3, #fda4af);
}

/* ---------------- 列表 ---------------- */

.list {
  margin-top: 24rpx;
}

.row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
  background: var(--surface);
  border-radius: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.row-me {
  background: linear-gradient(120deg, #eff6ff, #e0f2fe);
  box-shadow: 0 0 0 2rpx #bae6fd;
}

.rank {
  width: 48rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-3);
  text-align: center;
}

.name {
  flex: 1;
  font-size: 27rpx;
  color: var(--ink);
}

.count {
  font-size: 28rpx;
  font-weight: 800;
  color: #0284c7;
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  font-size: 26rpx;
  border-radius: 50%;
}

/* ---------------- 占位 ---------------- */

.podium-skeleton {
  margin-top: 24rpx;
}

.sk-podium {
  height: 300rpx;
  margin-bottom: 20rpx;
}

.sk-row {
  height: 96rpx;
  margin-bottom: 12rpx;
}

.placeholder {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
  padding: 100rpx 0;
  text-align: center;
}

.placeholder-emoji {
  font-size: 64rpx;
}

.foot {
  display: block;
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
}
