.seg {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  background: #eef2f7;
  border-radius: 20rpx;
}

.seg-item {
  flex: 1;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  text-align: center;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.seg-active {
  color: #0284c7;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.metrics {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.metric {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}

.metric-active {
  color: #0284c7;
  background: var(--brand-soft);
  border-color: var(--brand);
}

/* 我的名次 */
.me {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(14, 165, 233, 0.26);
}

.me-left {
  display: flex;
  flex-direction: column;
}

.me-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.me-value {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.me-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 列表 */
.list {
  margin-top: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 2rpx solid #f4f7fb;
}

.row:last-child {
  border-bottom: none;
}

.row-me {
  background: #f0f9ff;
}

.rank {
  width: 56rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-3);
  text-align: center;
}

.medal-1 {
  color: #d97706;
}

.medal-2 {
  color: #64748b;
}

.medal-3 {
  color: #b45309;
}

.avatar-sm {
  width: 68rpx;
  height: 68rpx;
  font-size: 26rpx;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
}

.count {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.foot {
  display: block;
  margin-top: 32rpx;
  text-align: center;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
