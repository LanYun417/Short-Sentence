<view class="page">
  <!-- 周期 -->
  <view class="seg anim-fade">
    <view
      wx:for="{{periods}}"
      wx:key="key"
      class="seg-item {{item.key === period ? 'seg-active' : ''}}"
      hover-class="press-hover"
      data-key="{{item.key}}"
      bindtap="onPickPeriod"
    >{{item.label}}</view>
  </view>

  <!-- 指标（打卡榜没有指标维度） -->
  <view wx:if="{{!isCheckin}}" class="metrics anim-fade d1">
    <view
      class="metric {{metric === 'answered' ? 'metric-active' : ''}}"
      hover-class="press-hover"
      data-metric="answered"
      bindtap="onPickMetric"
    >答题数</view>
    <view
      class="metric {{metric === 'correct' ? 'metric-active' : ''}}"
      hover-class="press-hover"
      data-metric="correct"
      bindtap="onPickMetric"
    >答对数</view>
  </view>

  <!-- 我的名次 -->
  <view class="me anim-up d1 {{meRank > 0 ? 'me-on' : ''}}">
    <view class="me-badge">🏆</view>
    <view class="me-left">
      <text class="me-label">我的名次</text>
      <text class="me-value">{{meText}}</text>
    </view>
  </view>

  <!-- 加载 -->
  <view wx:if="{{loading}}" class="podium-skeleton">
    <view class="skeleton sk-podium"></view>
    <view class="skeleton sk-row"></view>
    <view class="skeleton sk-row"></view>
    <view class="skeleton sk-row"></view>
  </view>

  <view wx:elif="{{empty}}" class="placeholder">
    <text class="placeholder-emoji">🏁</text>
    <text class="muted">这个榜还没有人上榜，去刷题抢第一</text>
  </view>

  <block wx:else>
    <!-- 前三名领奖台 -->
    <view wx:if="{{podium.length > 0}}" class="podium">
      <view wx:for="{{podium}}" wx:key="userId" class="podium-item podium-{{item.rank}} anim-up d{{item.rank}}">
        <view class="podium-avatar {{item.isMe ? 'podium-me' : ''}}">
          <image wx:if="{{item.avatarUrl}}" class="avatar-image" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{item.initial}}</text>
        </view>
        <view class="podium-medal medal-{{item.rank}}">{{item.rank}}</view>
        <text class="podium-name ellipsis">{{item.nickname}}</text>
        <text class="podium-count mono">{{item.countText}}</text>
        <view class="podium-base base-{{item.rank}}"></view>
      </view>
    </view>

    <!-- 第 4 名起 -->
    <view class="list">
      <view
        wx:for="{{rest}}"
        wx:key="userId"
        class="row anim-up {{item.isMe ? 'row-me' : ''}}"
        style="animation-delay: {{index < 10 ? index * 35 : 0}}ms"
      >
        <text class="rank mono">{{item.rank}}</text>
        <view class="avatar avatar-sm">
          <image wx:if="{{item.avatarUrl}}" class="avatar-image" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{item.initial}}</text>
        </view>
        <text class="name ellipsis">{{item.nickname}}</text>
        <text class="count mono">{{item.countText}}</text>
      </view>
    </view>
  </block>

  <text class="foot muted">{{isCheckin ? '累计打卡天数，长期有效' : '榜单每分钟刷新一次'}}</text>
</view>
