.section {
  margin-top: 32rpx;
}

.label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.textarea {
  width: 100%;
  height: 260rpx;
  padding: 24rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink);
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
}

.ph {
  color: var(--ink-3);
}

.counter {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: right;
}

.field {
  height: 92rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: var(--ink);
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
}

.type {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.status {
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
}

.status-pending {
  color: #b45309;
  background: #fef3c7;
}

.status-resolved {
  color: #047857;
  background: #ecfdf5;
}

.status-dismissed {
  color: #64748b;
  background: #f1f5f9;
}

.content {
  display: block;
  margin: 10rpx 0 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.reply {
  display: block;
  margin-bottom: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #0284c7;
  background: #f0f9ff;
  border-radius: 14rpx;
}
