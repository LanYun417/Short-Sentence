<view class="page">
  <!-- 用户卡 -->
  <view class="card user-card anim-up">
    <view class="user-blob"></view>
    <view class="avatar-ring">
      <view class="avatar avatar-lg">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
        <text wx:else>{{initial || 'S'}}</text>
      </view>
    </view>
    <view class="user-info">
      <text class="user-name">{{user.nickname || '学习者'}}</text>
      <text class="user-sub">{{accountLabel}}</text>
    </view>
  </view>

  <!-- 成长摘要 -->
  <view class="card stats anim-up d1">
    <view class="stat">
      <text class="stat-num mono">{{xpText}}</text>
      <text class="stat-label">经验</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <text class="stat-num mono">{{streakText}}</text>
      <text class="stat-label">连续打卡</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <text class="stat-num mono">{{achievementText}}</text>
      <text class="stat-label">成就</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-grid anim-up d2">
    <view
      wx:for="{{group1}}"
      wx:key="key"
      class="menu-item"
      hover-class="menu-item-hover"
      data-key="{{item.key}}"
      bindtap="onMenu"
    >
      <view class="menu-icon">{{item.icon}}</view>
      <text class="menu-label">{{item.label}}</text>
    </view>
  </view>

  <view class="menu-grid anim-up d3">
    <view
      wx:for="{{group2}}"
      wx:key="key"
      class="menu-item"
      hover-class="menu-item-hover"
      data-key="{{item.key}}"
      bindtap="onMenu"
    >
      <view class="menu-icon">{{item.icon}}</view>
      <text class="menu-label">{{item.label}}</text>
    </view>
  </view>

  <view class="menu-grid anim-up d4">
    <view
      wx:for="{{group3}}"
      wx:key="key"
      class="menu-item"
      hover-class="menu-item-hover"
      data-key="{{item.key}}"
      bindtap="onMenu"
    >
      <view class="menu-icon">{{item.icon}}</view>
      <text class="menu-label">{{item.label}}</text>
      <text wx:if="{{item.key === 'notices' && noticeUnread > 0}}" class="menu-dot">{{noticeUnread}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="actions anim-up d5">
    <view class="action" hover-class="action-hover" bindtap="onExport">
      <text class="action-label">导出我的数据</text>
      <text class="action-arrow">›</text>
    </view>
    <view class="action action-danger" hover-class="action-hover" bindtap="onDelete">
      <text class="action-label">注销账号</text>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <view class="anim-up d6">
    <button class="btn btn-ghost btn-block logout" hover-class="press-hover" bindtap="onLogout">退出登录</button>
  </view>

  <view class="foot anim-fade d6">
    <view class="legal-links">
      <text class="legal-link" bindtap="onOpenTerms">用户协议</text>
      <text class="legal-sep">·</text>
      <text class="legal-link" bindtap="onOpenPrivacy">隐私政策</text>
    </view>
    <text class="muted">每日一句 · v{{version}}</text>
  </view>
</view>
