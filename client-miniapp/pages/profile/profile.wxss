.user-card {
  position: relative;
  display: flex;
  gap: 24rpx;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8 58%, #7dd3fc);
  box-shadow: 0 18rpx 40rpx rgba(14, 165, 233, 0.28);
}

/* 装饰光斑：让大面积渐变不显得空 */
.user-blob {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  animation: ss-breathe 6.5s ease-in-out infinite;
}

/* 头像外圈：白环，在渐变底上把头像"抠"出来 */
.avatar-ring {
  position: relative;
  padding: 5rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  font-size: 44rpx;
}

.user-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.user-name {
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-sub {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 32rpx 16rpx;
}

.stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.stat-divider {
  width: 2rpx;
  height: 52rpx;
  background: var(--line);
}

/* 功能入口 */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 12rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.menu-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33.333%;
  padding: 20rpx 0;
  border-radius: 20rpx;
  /* 按压反馈只做缩放：hover-class 是瞬时切换，靠这行让按下/回弹都是「缩一下」而不是硬跳 */
  transition: transform 120ms ease;
}

.menu-dot {
  position: absolute;
  top: 10rpx;
  right: 50%;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  margin-right: 4rpx;
  font-size: 18rpx;
  line-height: 30rpx;
  color: #ffffff;
  text-align: center;
  background: var(--danger);
  border-radius: 999rpx;
}

/* 按压：只缩小、不铺高亮底色（宫格本身没有卡片底，铺色会显得脏） */
.menu-item-hover {
  transform: scale(0.94);
}

/* 图标做成圆角色块，比裸 emoji 更有"入口"的形状感 */
.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  font-size: 34rpx;
  line-height: 1;
  background: linear-gradient(160deg, #f0f9ff, #e0f2fe);
  border-radius: 22rpx;
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}

.menu-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

/* 操作列表 */
.actions {
  margin-top: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 2rpx solid #f4f7fb;
}

.action:last-child {
  border-bottom: none;
}

.action-hover {
  background: #f8fafc;
}

.action-label {
  font-size: 28rpx;
  color: var(--ink);
}

.action-danger .action-label {
  color: var(--danger);
}

.action-arrow {
  font-size: 36rpx;
  color: var(--ink-3);
}

.logout {
  margin-top: 40rpx;
}

.legal-links {
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.legal-link {
  font-size: 24rpx;
  color: var(--brand);
}

.legal-sep {
  font-size: 24rpx;
  color: var(--ink-3);
}

.foot {
  margin-top: 48rpx;
  text-align: center;
}
