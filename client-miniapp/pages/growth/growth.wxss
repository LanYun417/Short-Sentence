/* 成长页：等级卡 / 统计 / 成就 / 场景 */

.hero {
  position: relative;
  padding: 36rpx 36rpx 30rpx;
  overflow: hidden;
  background: linear-gradient(140deg, #4f46e5 0%, #7c3aed 52%, #a78bfa 100%);
  border-radius: 36rpx;
  box-shadow: 0 22rpx 48rpx rgba(99, 102, 241, 0.3);
}

.hero-blob {
  position: absolute;
  top: -150rpx;
  right: -100rpx;
  width: 340rpx;
  height: 340rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 50%;
}

.hero-blob-2 {
  top: auto;
  right: auto;
  bottom: -190rpx;
  left: -120rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 255, 255, 0.1);
  animation: ss-breathe 7s ease-in-out infinite;
}

.hero-head {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-level {
  display: flex;
  flex-direction: column;
}

.hero-level-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 2rpx;
}

.hero-level-name {
  margin-top: 6rpx;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #ffffff;
  letter-spacing: -1rpx;
  text-shadow: 0 6rpx 20rpx rgba(49, 46, 129, 0.35);
}

.hero-xp {
  display: flex;
  align-items: baseline;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.hero-xp-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.hero-xp-unit {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.hero-bar {
  position: relative;
  height: 16rpx;
  margin-top: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.hero-bar-fill {
  position: relative;
  display: flex;
  justify-content: flex-end;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(90deg, #ffffff, #ede9fe);
  border-radius: 999rpx;
  box-shadow: 0 0 16rpx rgba(255, 255, 255, 0.6);
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.hero-bar-sheen {
  width: 60rpx;
  height: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0));
  animation: ss-sheen 3.8s ease-in-out infinite;
}

.hero-foot {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.hero-tip {
  flex: 1;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
}

.hero-percent {
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ---------------- 统计 ---------------- */

.stats {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  margin-top: 24rpx;
}

.stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.1;
  color: var(--ink);
  letter-spacing: -1rpx;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--line);
}

/* ---------------- 成就 ---------------- */

.section {
  margin-top: 40rpx;
}

.ach-progress {
  height: 8rpx;
  margin-top: 16rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.ach-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #a78bfa, #6366f1);
  border-radius: 999rpx;
  transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.ach-list {
  margin-top: 20rpx;
}

.ach {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.05);
}

/* 未解锁：整体降透明度 + 灰徽章，但仍然可读（不是"禁用"，是"待解锁"） */
.ach-locked .ach-name {
  color: var(--ink-2);
}

.ach-locked .ach-desc {
  color: var(--ink-3);
}

.ach-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-3);
  background: #f1f5f9;
  border-radius: 22rpx;
  transition: all 0.24s ease;
}

/* AI 大图（有 artUrl 时替换首字徽章；无图时回落上面的 .ach-icon） */
.ach-art {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  background: #f1f5f9;
  border-radius: 22rpx;
}

/* 已解锁的徽章：紫金渐变 + 外发光，和未解锁一眼分开 */
.ach-icon-on {
  color: #ffffff;
  background: linear-gradient(135deg, #8b5cf6, #6366f1);
  box-shadow: 0 8rpx 20rpx rgba(99, 102, 241, 0.3);
}

.ach-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.ach-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.ach-name {
  flex: 1;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ach-xp {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #7c3aed;
}

.ach-locked .ach-xp {
  color: var(--ink-3);
}

.ach-desc {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: var(--ink-2);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ach-check {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #34d399, #10b981);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.32);
}

.ach-skeleton {
  margin-top: 20rpx;
}

.ach-skeleton-row {
  height: 120rpx;
  margin-bottom: 16rpx;
}

/* ---------------- 场景 ---------------- */

.scene-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.scene {
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 16rpx 22rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}

.scene-on {
  background: var(--brand-soft);
  border-color: #bae6fd;
}

.scene-name {
  font-size: 24rpx;
  color: var(--ink-2);
}

.scene-locked {
  color: var(--ink-3);
}

.scene-count {
  min-width: 28rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-3);
  text-align: right;
}

.scene-on .scene-count {
  color: #0284c7;
}

.placeholder {
  padding: 60rpx 0;
  text-align: center;
}

/* ------------------------------ 记忆巩固 ------------------------------ */

.memory {
  margin-top: 24rpx;
}

.mem-stats {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  text-align: center;
}

.mem-stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.mem-num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
  color: var(--ink);
}

.mem-num-green {
  color: #059669;
}

.mem-num-blue {
  color: #0284c7;
}

.mem-num-indigo {
  color: #4f46e5;
}

.mem-label {
  font-size: 20rpx;
  color: var(--ink-3);
}

.mem-caption {
  display: block;
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.mem-bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 132rpx;
  margin-top: 12rpx;
  padding-bottom: 4rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.mem-bar-col {
  display: flex;
  flex: 1;
  align-items: flex-end;
  height: 100%;
}

.mem-bar {
  width: 100%;
  min-height: 6rpx;
  background: linear-gradient(180deg, #38bdf8, #0ea5e9);
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  transition: height 0.4s ease;
}

.mem-bar-empty {
  background: #e2e8f0;
}

.mem-retain {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.mem-retain-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.mem-retain-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #4f46e5;
}

.mem-retain-label {
  font-size: 20rpx;
  color: var(--ink-3);
}

.mem-retain-line {
  width: 28rpx;
  height: 2rpx;
  background: #e2e8f0;
}
