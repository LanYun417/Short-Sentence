<view class="page">
  <!-- 等级卡 -->
  <view class="hero anim-up">
    <view class="hero-blob"></view>
    <view class="hero-blob hero-blob-2"></view>

    <view class="hero-head">
      <view class="hero-level">
        <text class="hero-level-tag">当前等级</text>
        <text class="hero-level-name">{{levelName}}</text>
      </view>
      <view class="hero-xp">
        <text class="hero-xp-num mono">{{xpText}}</text>
        <text class="hero-xp-unit">XP</text>
      </view>
    </view>

    <view class="hero-bar">
      <view class="hero-bar-fill" style="width: {{levelPercent}}%">
        <view class="hero-bar-sheen"></view>
      </view>
    </view>

    <view class="hero-foot">
      <text class="hero-tip">{{levelTip}}</text>
      <text class="hero-percent mono">{{levelPercent}}%</text>
    </view>
  </view>

  <!-- 三个统计 -->
  <view class="card stats anim-up d1">
    <view class="stat">
      <text class="stat-num mono">{{unlockedAchievements}}</text>
      <text class="stat-label">已解锁成就</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <text class="stat-num mono">{{unlockedScenes}}</text>
      <text class="stat-label">已探索场景</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <text class="stat-num mono">{{totalAchievements}}</text>
      <text class="stat-label">成就总数</text>
    </view>
  </view>

  <!-- 记忆巩固：已复习 / 已毕业 / 到期分布 / 遗忘曲线（与 Web、App 同契约） -->
  <view wx:if="{{memory}}" class="card memory anim-up d1">
    <view class="row-between">
      <text class="subtitle">记忆巩固</text>
      <text class="muted">你的遗忘曲线</text>
    </view>

    <view class="mem-stats">
      <view class="mem-stat">
        <text class="mem-num mono">{{memory.reviewed}}</text>
        <text class="mem-label">已复习</text>
      </view>
      <view class="mem-stat">
        <text class="mem-num mono mem-num-green">{{memory.graduated}}</text>
        <text class="mem-label">已毕业</text>
      </view>
      <view class="mem-stat">
        <text class="mem-num mono mem-num-blue">{{memory.dueToday}}</text>
        <text class="mem-label">今日待复习</text>
      </view>
      <view class="mem-stat">
        <text class="mem-num mono mem-num-indigo">{{memory.dueIn7}}</text>
        <text class="mem-label">7天待复习</text>
      </view>
    </view>

    <text class="mem-caption">未来 30 天复习分布</text>
    <view class="mem-bars">
      <view wx:for="{{memoryBars}}" wx:key="day" class="mem-bar-col">
        <view class="mem-bar {{item.due > 0 ? '' : 'mem-bar-empty'}}" style="height: {{item.height}}%"></view>
      </view>
    </view>

    <text class="mem-caption">理论记忆保留率（每复习一次即被拉平）</text>
    <view class="mem-retain">
      <view class="mem-retain-item">
        <text class="mem-retain-num mono">100%</text>
        <text class="mem-retain-label">今天</text>
      </view>
      <view class="mem-retain-line"></view>
      <view class="mem-retain-item">
        <text class="mem-retain-num mono">{{retain7}}%</text>
        <text class="mem-retain-label">第 7 天</text>
      </view>
      <view class="mem-retain-line"></view>
      <view class="mem-retain-item">
        <text class="mem-retain-num mono">{{retain30}}%</text>
        <text class="mem-retain-label">第 30 天</text>
      </view>
    </view>

    <button wx:if="{{memory.dueToday > 0}}" class="btn btn-primary btn-block mt-24" bindtap="onStartReview">
      开始复习（{{memory.dueToday}} 张到期）
    </button>
  </view>

  <!-- 成就 -->
  <view class="section anim-up d2">
    <view class="row-between">
      <text class="subtitle">成就</text>
      <text class="muted">{{unlockedAchievements}} / {{totalAchievements}}</text>
    </view>

    <view class="ach-progress">
      <view class="ach-progress-fill" style="width: {{achPercent}}%"></view>
    </view>

    <view wx:if="{{loading}}" class="ach-skeleton">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skeleton ach-skeleton-row"></view>
    </view>

    <view wx:elif="{{achievements.length === 0}}" class="placeholder">
      <text class="muted">还没有成就，去刷几题吧</text>
    </view>

    <view wx:else class="ach-list">
      <view
        wx:for="{{achievements}}"
        wx:key="code"
        class="ach anim-up {{item.unlocked ? '' : 'ach-locked'}}"
        style="animation-delay: {{index < 8 ? index * 45 : 0}}ms"
      >
        <image wx:if="{{item.artSrc}}" class="ach-art" src="{{item.artSrc}}" mode="aspectFit" />
        <view wx:else class="ach-icon {{item.unlocked ? 'ach-icon-on' : ''}}">{{item.initial}}</view>
        <view class="ach-body">
          <view class="ach-title-row">
            <text class="ach-name">{{item.name}}</text>
            <text class="ach-xp">+{{item.rewardXp}} XP</text>
          </view>
          <text class="ach-desc">{{item.description}}</text>
        </view>
        <view wx:if="{{item.unlocked}}" class="ach-check">✓</view>
      </view>
    </view>
  </view>

  <!-- 场景 -->
  <view wx:if="{{scenes.length > 0}}" class="section anim-up d3">
    <view class="row-between">
      <text class="subtitle">场景</text>
      <text class="muted">{{unlockedScenes}} / {{totalScenes}}</text>
    </view>
    <view class="scene-list mt-16">
      <view wx:for="{{scenes}}" wx:key="id" class="scene {{item.unlocked ? 'scene-on' : ''}}">
        <text class="scene-name {{item.unlocked ? '' : 'scene-locked'}}">{{item.name}}</text>
        <text class="scene-count mono">{{item.practicedCount}}</text>
      </view>
    </view>
  </view>
</view>
