/* 注销账号：警示 + 可选原因 + 身份校验 */

.warn {
  display: flex;
  flex-direction: column;
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  border-radius: 24rpx;
}

.warn-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #b91c1c;
}

.warn-item {
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #7f1d1d;
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: var(--surface);
  border-radius: 24rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.small {
  font-size: 24rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.textarea {
  width: 100%;
  height: 140rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink);
  background: var(--bg);
  border-radius: 16rpx;
}

.ph {
  color: var(--ink-3);
}

.counter {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: right;
}

.verify-tip {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.input {
  flex: 1;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  background: var(--bg);
  border-radius: 16rpx;
}

.code-btn {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 16rpx;
}

.code-btn-off {
  color: var(--ink-3);
  background: var(--bg);
}

.btn-danger {
  color: #ffffff;
  background: var(--danger);
}

.foot {
  margin-top: 24rpx;
  text-align: center;
}
