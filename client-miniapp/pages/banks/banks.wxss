.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  width: calc(50% - 10rpx);
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.06);
}

.grid-item-hover {
  background: #f8fafc;
}

.grid-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.grid-en {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.grid-count {
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #0284c7;
}

.fest-list {
  margin-top: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.fest {
  display: flex;
  gap: 22rpx;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #f4f7fb;
}

.fest:last-child {
  border-bottom: none;
}

.fest-hover {
  background: #f8fafc;
}

.fest-cover {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 96rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #fde68a, #fbbf24);
  border-radius: 20rpx;
}

.fest-img {
  width: 100%;
  height: 100%;
}

.fest-initial {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400e;
}

.fest-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.fest-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.fest-arrow {
  font-size: 36rpx;
  color: var(--ink-3);
}
