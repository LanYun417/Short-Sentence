<view class="page">
  <view class="head row-between">
    <text class="head-title">未读 {{unread}} 条</text>
    <text wx:if="{{unread > 0}}" class="head-action" bindtap="onReadAll">全部已读</text>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{items.length === 0}}" class="empty">还没有通知</view>

  <view wx:else class="list-card">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="notice"
      hover-class="list-row-hover"
      data-index="{{index}}"
      bindtap="onOpen"
    >
      <view class="row-between">
        <view class="notice-title-row">
          <text wx:if="{{item.pinned}}" class="badge badge-amber">置顶</text>
          <text wx:if="{{item.unread}}" class="dot"></text>
          <text class="notice-title">{{item.title}}</text>
        </view>
        <text class="notice-time">{{item.time}}</text>
      </view>
      <text class="notice-type">{{item.typeText}}</text>
      <text class="notice-content {{expandedId === item.id ? 'notice-full' : ''}}">{{item.content}}</text>
      <text class="notice-more">{{expandedId === item.id ? '收起' : '展开'}}</text>
    </view>
  </view>

  <text class="page-foot">{{hasMore ? '上拉加载更多' : '没有更多了'}}</text>
</view>
