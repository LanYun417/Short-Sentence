.head {
  margin-top: 8rpx;
}

.head-title {
  font-size: 26rpx;
  color: var(--ink-2);
}

.head-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #0284c7;
}

.notice {
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid #f4f7fb;
}

.notice:last-child {
  border-bottom: none;
}

.notice-title-row {
  display: flex;
  flex: 1;
  gap: 12rpx;
  align-items: center;
  min-width: 0;
}

.dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  background: var(--danger);
  border-radius: 50%;
}

.notice-title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.notice-type {
  display: inline-block;
  margin-top: 10rpx;
  padding: 2rpx 12rpx;
  font-size: 19rpx;
  color: var(--ink-3);
  background: #f1f5f9;
  border-radius: 8rpx;
}

.notice-content {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notice-full {
  display: block;
  -webkit-line-clamp: unset;
}

.notice-more {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #0284c7;
}
