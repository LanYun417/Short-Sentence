.search {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-top: 8rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}

.search-ph {
  color: var(--ink-3);
}

.search-btn {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 36rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  border-radius: 999rpx;
}

.section-title {
  display: block;
  margin-top: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-2);
}

.word {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.phonetic {
  font-size: 23rpx;
  color: var(--ink-3);
}

.meaning {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}

.parts {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #0284c7;
}

.ai-hint {
  margin-top: 32rpx;
  padding: 32rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.ai-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.ai-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

/* 详情 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.42);
}

.sheet {
  width: 100%;
  max-height: 82vh;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}

.sheet-head {
  display: flex;
  gap: 16rpx;
  align-items: baseline;
}

.sheet-word {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
}

.sheet-phonetic {
  font-size: 24rpx;
  color: var(--ink-3);
}

.sheet-meaning {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.parts-box {
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
  background: #f6f8fb;
  border-radius: 20rpx;
}

.part {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #eef2f7;
}

.part:last-child {
  border-bottom: none;
}

.part-label {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #0284c7;
  background: var(--brand-soft);
  border-radius: 8rpx;
}

.part-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.part-meaning {
  flex: 1;
  font-size: 23rpx;
  color: var(--ink-2);
  text-align: right;
}

.sheet-explain {
  display: block;
  margin-top: 24rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

.related {
  margin-top: 24rpx;
}

.sheet-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--ink-3);
}

.related-text {
  font-size: 25rpx;
  color: var(--ink-2);
}
