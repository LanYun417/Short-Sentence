.kinds {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.item-en {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-zh {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}

.item-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.tag-ok {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  color: #047857;
  background: #ecfdf5;
  border-radius: 999rpx;
}

.tag-bad {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  color: #b91c1c;
  background: #fef2f2;
  border-radius: 999rpx;
}

.empty-btn {
  width: 320rpx;
  margin: 32rpx auto 0;
  font-size: 28rpx;
}

/* 详情弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.42);
}

.sheet {
  width: 100%;
  max-height: 78vh;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.sheet-close {
  font-size: 24rpx;
  color: var(--ink-3);
}

.sheet-en {
  display: block;
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
}

.sheet-ipa {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.sheet-zh {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.sheet-block {
  margin-top: 24rpx;
}

.sheet-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--ink-3);
}

.sheet-text {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}
