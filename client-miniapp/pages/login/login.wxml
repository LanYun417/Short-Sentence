<view class="login">
  <view class="brand">
    <view class="logo">S</view>
    <text class="brand-name">每日一句</text>
    <text class="brand-slogan">看中文 · 写英文 · 一天一句</text>
  </view>

  <view class="panel">
    <block wx:if="{{mode === 'wechat'}}">
      <view class="agree-row" bindtap="onToggleAgreed">
        <checkbox checked="{{agreed}}" color="#0ea5e9" />
        <text class="agree-text">已仔细阅读并同意《用户协议》与《隐私政策》</text>
      </view>
      <button
        class="btn btn-primary btn-block {{loading ? 'btn-disabled' : ''}}"
        bindtap="onWechatLogin"
      >{{loading ? '登录中…' : '微信一键登录'}}</button>
      <view class="switch" bindtap="onSwitchMode">已有邮箱账号？用密码登录</view>
    </block>

    <block wx:else>
      <input
        class="field"
        type="text"
        value="{{email}}"
        placeholder="邮箱"
        placeholder-class="field-ph"
        bindinput="onEmailInput"
      />
      <!-- 邮箱验证码登录：验证码 + 发送按钮 -->
      <view wx:if="{{mode === 'code'}}" class="code-row">
        <input
          class="field field-code"
          type="number"
          value="{{emailCode}}"
          placeholder="邮箱验证码"
          placeholder-class="field-ph"
          maxlength="6"
          bindinput="onCodeInput"
        />
        <button class="code-btn" disabled="{{codeSending || codeCountdown > 0}}" bindtap="onSendCode">
          {{codeSending ? '发送中' : codeCountdown > 0 ? codeCountdown + 's' : '发送验证码'}}
        </button>
      </view>
      <!-- 密码登录 -->
      <input
        wx:else
        class="field"
        password
        value="{{password}}"
        placeholder="密码"
        placeholder-class="field-ph"
        bindinput="onPasswordInput"
      />
      <button
        class="btn btn-primary btn-block login-btn {{loading ? 'btn-disabled' : ''}}"
        bindtap="{{mode === 'code' ? 'onCodeLogin' : 'onEmailLogin'}}"
      >{{loading ? '登录中…' : '登录'}}</button>
      <view class="switch" bindtap="onSwitchMode">返回微信登录</view>
      <view class="switch switch-link" bindtap="onToggleLoginMode">
        {{mode === 'code' ? '使用密码登录' : '使用邮箱验证码登录'}}
      </view>
    </block>
  </view>

  <view class="tip">
    <text>登录即表示同意</text>
    <text class="link" bindtap="onOpenTerms">《用户协议》</text>
    <text>与</text>
    <text class="link" bindtap="onOpenPrivacy">《隐私政策》</text>
  </view>
</view>
