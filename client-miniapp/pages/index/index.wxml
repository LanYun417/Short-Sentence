<view class="page">
  <!-- 问候 + 头像 -->
  <view class="head">
    <view class="head-text">
      <text class="head-greeting">{{greeting}}</text>
      <text class="head-name">{{user.nickname || '学习者'}}</text>
    </view>
    <view class="avatar" bindtap="onTapProfile">
      <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{initial || 'S'}}</text>
    </view>
  </view>

  <!-- 今日进度 -->
  <view class="hero">
    <view class="hero-head">
      <text class="hero-label">今日目标</text>
      <view class="hero-streak">连续 {{checkin.streak}} 天</view>
    </view>
    <view class="hero-value">
      <text class="hero-num mono">{{checkin.doneCount}}</text>
      <text class="hero-goal">/ {{checkin.goalCount}} 题</text>
    </view>
    <view class="hero-bar">
      <view class="hero-bar-fill" style="width: {{percent}}%"></view>
    </view>
    <text class="hero-tip">{{tip}}</text>
  </view>

  <!-- 难度 -->
  <view class="section">
    <view class="row-between">
      <text class="subtitle">练习难度</text>
      <text class="muted">可随时切换</text>
    </view>
    <view class="seg">
      <view
        wx:for="{{difficulties}}"
        wx:key="value"
        class="seg-item {{item.value === difficulty ? 'seg-item-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onPickDifficulty"
      >
        <text class="seg-label">{{item.label}}</text>
        <text class="seg-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 入口 -->
  <button class="btn btn-primary btn-block start" bindtap="onStart">开始练习</button>
  <button class="btn btn-ghost btn-block review" bindtap="onReview">复习错题</button>

  <view class="foot">
    <text class="muted">看中文 · 写英文 · 翻卡即答</text>
  </view>
</view>
