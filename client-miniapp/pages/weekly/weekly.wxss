.hero {
  padding: 36rpx;
  background: linear-gradient(140deg, #0f766e 0%, #14b8a6 58%, #99f6e4 100%);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 40rpx rgba(13, 148, 136, 0.26);
}

.hero-label {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.86);
}

.hero-value {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.hero-num {
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1.05;
  color: #ffffff;
  letter-spacing: -3rpx;
}

.hero-unit {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.hero-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hero-delta {
  padding: 4rpx 16rpx;
  font-size: 21rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.delta-down {
  background: rgba(255, 255, 255, 0.16);
}

.grid {
  display: flex;
  margin-top: 24rpx;
  padding: 28rpx 8rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.grid-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.grid-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
}

.grid-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.section {
  margin-top: 36rpx;
}

.chart {
  display: flex;
  gap: 12rpx;
  align-items: flex-end;
  height: 260rpx;
  margin-top: 20rpx;
  padding: 24rpx 20rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.bar-col {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-value {
  font-size: 20rpx;
  color: var(--ink-3);
}

.bar-track {
  display: flex;
  align-items: flex-end;
  width: 40rpx;
  height: 150rpx;
  margin: 6rpx 0;
  overflow: hidden;
  background: #f1f5f9;
  border-radius: 999rpx;
}

.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #5eead4, #14b8a6);
  border-radius: 999rpx;
}

.bar-label {
  font-size: 20rpx;
  color: var(--ink-3);
}

.top-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
