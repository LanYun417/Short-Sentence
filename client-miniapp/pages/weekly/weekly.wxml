<view class="page">
  <view wx:if="{{loading}}" class="empty">统计中…</view>

  <block wx:elif="{{report}}">
    <!-- 主卡 -->
    <view class="hero">
      <text class="hero-label">本周答题</text>
      <view class="hero-value">
        <text class="hero-num mono">{{report.answered}}</text>
        <text class="hero-unit">题</text>
      </view>
      <view class="hero-row">
        <text class="hero-meta">正确率 {{accuracyText}}</text>
        <text class="hero-delta {{deltaDown ? 'delta-down' : ''}}">{{deltaText}}</text>
      </view>
    </view>

    <!-- 四宫格 -->
    <view class="grid">
      <view class="grid-item">
        <text class="grid-num mono">{{report.activeDays}}</text>
        <text class="grid-label">活跃天数</text>
      </view>
      <view class="grid-item">
        <text class="grid-num mono">{{report.xpGained}}</text>
        <text class="grid-label">获得经验</text>
      </view>
      <view class="grid-item">
        <text class="grid-num mono">{{report.newAchievements}}</text>
        <text class="grid-label">新成就</text>
      </view>
      <view class="grid-item">
        <text class="grid-num mono">{{report.streak}}</text>
        <text class="grid-label">连续打卡</text>
      </view>
    </view>

    <!-- 每日明细 -->
    <view class="section">
      <text class="subtitle">每日明细</text>
      <view class="chart">
        <view wx:for="{{days}}" wx:key="date" class="bar-col">
          <text class="bar-value">{{item.answered}}</text>
          <view class="bar-track">
            <view class="bar-fill" style="height: {{item.percent}}%"></view>
          </view>
          <text class="bar-label">{{item.weekday}}</text>
        </view>
      </view>
    </view>

    <!-- 场景 -->
    <view wx:if="{{report.topCategory}}" class="section">
      <text class="subtitle">练得最多的场景</text>
      <view class="card mt-16">
        <view class="row-between">
          <text class="top-name">{{report.topCategory.name}}</text>
          <text class="badge">{{report.topCategory.count}} 题</text>
        </view>
      </view>
    </view>

    <text class="page-foot">每周一自动开启新的一周，历史数据保留在「语句库 → 记录」</text>
  </block>
</view>
