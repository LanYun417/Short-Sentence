.legal {
  padding: 32rpx 28rpx 64rpx;
}

.legal-head {
  margin-bottom: 36rpx;
}

.legal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.legal-date {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.legal-section {
  margin-bottom: 40rpx;
  padding: 28rpx;
  background: var(--surface);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.05);
}

.legal-h2 {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.legal-p {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

.legal-list {
  margin-top: 8rpx;
}

.legal-li {
  display: flex;
  margin-top: 12rpx;
}

.legal-dot {
  margin-right: 12rpx;
  font-size: 28rpx;
  color: var(--brand);
}

.legal-li-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

.legal-foot {
  padding: 0 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
}
