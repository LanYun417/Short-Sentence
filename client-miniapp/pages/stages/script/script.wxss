.head {
  padding: 8rpx 8rpx 0;
}

.head-scene {
  display: block;
}

.head-name {
  display: block;
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -1rpx;
}

.head-blurb {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--ink-2);
}

.head-bar {
  height: 10rpx;
  margin: 20rpx 0 10rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.head-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #14b8a6, #5eead4);
  border-radius: 999rpx;
}

.stage-list {
  margin-top: 32rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.stage {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid #f4f7fb;
}

.stage:last-child {
  border-bottom: none;
}

.stage-hover {
  background: #f8fafc;
}

.stage-locked {
  opacity: 0.5;
}

.stage-no {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f766e;
  background: #ccfbf1;
  border-radius: 50%;
}

.stage-no-done {
  color: #ffffff;
  background: linear-gradient(135deg, #14b8a6, #5eead4);
}

.stage-body {
  flex: 1;
  min-width: 0;
}

.stage-title-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.stage-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.stage-goal {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink-2);
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.stage-meta {
  margin-top: 8rpx;
}

.stage-bar {
  height: 8rpx;
  margin-top: 12rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.stage-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #14b8a6, #5eead4);
  border-radius: 999rpx;
}

.stage-state {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

.placeholder {
  padding: 120rpx 0;
  text-align: center;
}
