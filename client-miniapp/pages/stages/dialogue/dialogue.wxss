.dialogue {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ---------------- 关卡头 ---------------- */

.bar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #ffffff;
  border-bottom: 2rpx solid var(--line);
}

.bar-goal {
  display: flex;
  flex: 1;
  gap: 10rpx;
  align-items: center;
  min-width: 0;
}

.bar-label {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #0369a1;
  background: var(--brand-soft);
  border-radius: 8rpx;
}

.bar-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ink-2);
}

.bar-side {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
  align-items: center;
}

.turn {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-3);
}

.tr-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-3);
  background: #f1f5f9;
  border-radius: 50%;
}

.tr-on {
  color: #ffffff;
  background: var(--brand);
}

.end {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--danger);
  background: #fef2f2;
  border-radius: 999rpx;
}

/* ---------------- 对话流 ---------------- */

.chat {
  flex: 1 1 0;
  height: 0;
  padding: 0 24rpx;
}

.intro {
  margin: 24rpx 4rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border-left: 8rpx solid #14b8a6;
}

.intro-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: #0f766e;
  letter-spacing: 1rpx;
}

.intro-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.msg {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  font-size: 32rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.06);
}

.msg-body {
  display: flex;
  flex-direction: column;
  max-width: 76%;
}

.msg-user .msg-body {
  align-items: flex-end;
}

.msg-speaker {
  margin-bottom: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink-3);
}

.bubble {
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 4rpx 24rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.05);
}

.msg-user .bubble {
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  border-radius: 24rpx 4rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.24);
}

.bubble-en {
  display: block;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--ink);
  word-break: break-word;
}

.msg-user .bubble-en {
  color: #ffffff;
}

.bubble-zh {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

.msg-user .bubble-zh {
  color: rgba(255, 255, 255, 0.82);
}

.bubble-typing {
  background: #ffffff;
}

.typing {
  font-size: 24rpx;
  color: var(--ink-3);
}

.chat-pad {
  height: 24rpx;
}

/* ---------------- 候选短句 ---------------- */

.hints {
  flex-shrink: 0;
  padding: 16rpx 24rpx 0;
  white-space: nowrap;
  background: var(--bg);
}

.hint {
  display: inline-flex;
  flex-direction: column;
  max-width: 460rpx;
  margin-right: 16rpx;
  padding: 14rpx 22rpx;
  vertical-align: top;
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
}

.hint-hover {
  background: #f0f9ff;
  border-color: var(--brand);
}

.hint-en {
  overflow: hidden;
  font-size: 25rpx;
  color: var(--ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hint-zh {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 21rpx;
  color: var(--ink-3);
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------------- 输入 ---------------- */

.composer {
  display: flex;
  flex-shrink: 0;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.composer-input {
  flex: 1;
  height: 88rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}

.composer-ph {
  color: var(--ink-3);
}

.composer-send {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 36rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.26);
}

.composer-send-off {
  background: #cbd5e1;
  box-shadow: none;
}

/* ---------------- 复盘面板 ---------------- */

.panel {
  flex-shrink: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.1);
}

.panel-scroll {
  max-height: 44vh;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}

.panel-xp {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #b45309;
  background: #fef3c7;
  border-radius: 999rpx;
}

.panel-summary {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.panel-block {
  margin-top: 20rpx;
}

.panel-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.panel-item {
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.panel-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.panel-btn {
  margin-top: 24rpx;
}

/* ---------------- 通用 ---------------- */

.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx;
  text-align: center;
}
