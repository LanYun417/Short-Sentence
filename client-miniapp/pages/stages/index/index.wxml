<view class="page">
  <!-- 总进度 -->
  <view class="hero">
    <view class="hero-head">
      <text class="hero-label">闯关进度</text>
      <view wx:if="{{claimable > 0}}" class="hero-bonus">{{claimable}} 份奖励待领</view>
    </view>
    <view class="hero-value">
      <text class="hero-num mono">{{clearedStages}}</text>
      <text class="hero-goal">/ {{totalStages}} 关</text>
    </view>
    <view class="hero-bar">
      <view class="hero-bar-fill" style="width: {{percent}}%"></view>
    </view>
    <button
      class="hero-btn {{recommendedId ? '' : 'hero-btn-off'}}"
      bindtap="onContinue"
    >{{recommendedId ? '继续闯关' : '暂无可闯关卡'}}</button>
  </view>

  <!-- 加载 / 空 -->
  <view wx:if="{{loading}}" class="placeholder">
    <text class="muted">加载中…</text>
  </view>

  <view wx:elif="{{empty}}" class="placeholder">
    <text class="muted">还没有开放的关卡，稍后再来看看</text>
  </view>

  <!-- 场景列表 -->
  <view wx:else class="scene-list">
    <view
      wx:for="{{scenes}}"
      wx:key="id"
      class="scene"
      hover-class="scene-hover"
      data-id="{{item.id}}"
      bindtap="onOpenScene"
    >
      <view class="cover">
        <image wx:if="{{item.coverUrl}}" class="cover-img" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
        <text wx:else class="cover-text">{{item.initial}}</text>
      </view>

      <view class="scene-body">
        <view class="scene-title-row">
          <text class="scene-name ellipsis">{{item.name}}</text>
          <text wx:if="{{item.done}}" class="badge">已通关</text>
        </view>
        <text class="scene-en ellipsis">{{item.nameEn || ' '}}</text>
        <view class="scene-bar">
          <view class="scene-bar-fill" style="width: {{item.percent}}%"></view>
        </view>
        <text class="muted">{{item.clearedCount}} / {{item.stageCount}} 关 · {{item.scriptCount}} 个剧本</text>
      </view>

      <text class="arrow">›</text>
    </view>
  </view>
</view>
