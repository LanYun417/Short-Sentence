.hero {
  padding: 40rpx;
  background: linear-gradient(140deg, #0f766e 0%, #14b8a6 58%, #5eead4 100%);
  border-radius: 36rpx;
  box-shadow: 0 20rpx 44rpx rgba(13, 148, 136, 0.28);
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-label {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
}

.hero-bonus {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
}

.hero-value {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.hero-num {
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #ffffff;
  letter-spacing: -2rpx;
}

.hero-goal {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.86);
}

.hero-bar {
  height: 14rpx;
  margin-top: 20rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
}

.hero-bar-fill {
  height: 100%;
  background: #ffffff;
  border-radius: 999rpx;
  transition: width 0.45s ease;
}

.hero-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f766e;
  background: #ffffff;
  border: none;
  border-radius: 999rpx;
}

.hero-btn::after {
  border: none;
}

.hero-btn-off {
  color: var(--ink-3);
  background: rgba(255, 255, 255, 0.6);
}

/* 场景列表 */
.scene-list {
  margin-top: 32rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.scene {
  display: flex;
  gap: 22rpx;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #f4f7fb;
}

.scene:last-child {
  border-bottom: none;
}

.scene-hover {
  background: #f8fafc;
}

.cover {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #99f6e4, #5eead4);
  border-radius: 24rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f766e;
}

.scene-body {
  flex: 1;
  min-width: 0;
}

.scene-title-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.scene-name {
  max-width: 380rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.scene-en {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.scene-bar {
  height: 10rpx;
  margin: 12rpx 0 8rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.scene-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #14b8a6, #5eead4);
  border-radius: 999rpx;
}

.arrow {
  font-size: 36rpx;
  color: var(--ink-3);
}

.placeholder {
  padding: 120rpx 0;
  text-align: center;
}
